# OpenAI-compatible local/provider endpoint.
# LM Studio default:
LEVIATHAN_LLM_BASE_URL=http://127.0.0.1:1234/v1

# Leave empty to auto-discover the first model from /v1/models.
LEVIATHAN_LLM_MODEL=

# Local servers usually ignore this. Remote OpenAI-compatible servers may require it.
# Never exposed via /api/health public_summary.
LEVIATHAN_LLM_API_KEY=not-needed

LEVIATHAN_LLM_TIMEOUT_SECONDS=90
LEVIATHAN_DATABASE_PATH=Data/backend/data/leviathan.db
LEVIATHAN_KNOWLEDGE_TOP_K=5
LEVIATHAN_KNOWLEDGE_CHUNK_MAX_CHARS=1200
LEVIATHAN_KNOWLEDGE_CHUNK_OVERLAP=120
LEVIATHAN_MAX_HISTORY_MESSAGES=24
LEVIATHAN_REASONING_ENABLED=true

# Runtime bind (defaults stay local-first).
LEVIATHAN_HOST=127.0.0.1
LEVIATHAN_PORT=8765
LEVIATHAN_LOOPBACK_ONLY=true

# Bulk corpora root (outside Git). Default matches the master program.
LEVIATHAN_DATA_ROOT=D:/ModelData

# Artifact bytes live on disk; metadata in SQLite.
LEVIATHAN_ARTIFACTS_ROOT=Data/backend/data/artifacts

# Local SQLite + artifact snapshots (Phase 39).
LEVIATHAN_BACKUP_ROOT=Data/backend/data/backups

# Context Engine token budgeting (chars/4 heuristic).
LEVIATHAN_CONTEXT_TOKEN_BUDGET=6000
LEVIATHAN_CONTEXT_RESERVE_RESPONSE_TOKENS=512
LEVIATHAN_CONTEXT_MAX_KNOWLEDGE_CHARS=1800

# Resource admission ceilings (Resource Manager / Job runtime).
LEVIATHAN_MAX_MODEL_CONCURRENCY=1
LEVIATHAN_MAX_FUNCTION_CONCURRENCY=2
LEVIATHAN_MAX_JOB_CONCURRENCY=1

# Network capability (disabled by default).
LEVIATHAN_NETWORK_ALLOW_OUTBOUND=false

# Chaos / resilience injection (Phase 41). Default OFF.
# Refused when LEVIATHAN_LOOPBACK_ONLY=false.
LEVIATHAN_CHAOS_ENABLED=false
LEVIATHAN_CHAOS_LATENCY_MS=0
LEVIATHAN_CHAOS_ERROR_RATE=0

# Feature flags (experimental; never bypass security).
LEVIATHAN_FEATURE_ITERATIVE_RETRIEVAL=false
LEVIATHAN_FEATURE_MEMORY_SEMANTIC=false
LEVIATHAN_FEATURE_NEURO=false
LEVIATHAN_FEATURE_NEURO_ASSOCIATIVE_MEMORY=false
LEVIATHAN_FEATURE_NEURO_PROCESS_CRITIC=false
LEVIATHAN_FEATURE_NEURO_RESIDUAL_INJECTION=false
LEVIATHAN_FEATURE_AGENTS=false
