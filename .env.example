# OpenAI-compatible local/provider endpoint.
# LM Studio default:
LEVIATHAN_LLM_BASE_URL=http://127.0.0.1:1234/v1

# Leave empty to auto-discover the first model from /v1/models.
LEVIATHAN_LLM_MODEL=

# Local servers usually ignore this. Remote OpenAI-compatible servers may require it.
# Never exposed via /api/health public_summary.
LEVIATHAN_LLM_API_KEY=not-needed

LEVIATHAN_LLM_TIMEOUT_SECONDS=90
LEVIATHAN_DATABASE_PATH=Data/backend/data/leviathan.db
LEVIATHAN_KNOWLEDGE_TOP_K=5
LEVIATHAN_KNOWLEDGE_CHUNK_MAX_CHARS=1200
LEVIATHAN_KNOWLEDGE_CHUNK_OVERLAP=120
LEVIATHAN_MAX_HISTORY_MESSAGES=24
LEVIATHAN_REASONING_ENABLED=true

# Runtime bind (defaults stay local-first).
LEVIATHAN_HOST=127.0.0.1
LEVIATHAN_PORT=8765
LEVIATHAN_LOOPBACK_ONLY=true

# Bulk corpora root (outside Git). Default matches the master program.
LEVIATHAN_DATA_ROOT=D:/ModelData

# Writable corpus override for datasets/training/research artifacts.
# When unset, uses {DATA_ROOT}/leviathan if writable, else Data/backend/data/corpora.
# LEVIATHAN_CORPUS_ROOT=Data/backend/data/corpora

# Hugging Face token for gated/private datasets (never returned by GET APIs).
# LEVIATHAN_HF_TOKEN=

# Hugging Face dataset download tuning (repository-level import).
# Network read size in MiB (bounded 4–64; default 16).
# LEVIATHAN_HF_DOWNLOAD_CHUNK_MB=16
# Concurrent shard download workers (bounded 1–16; default 6).
# LEVIATHAN_HF_DOWNLOAD_WORKERS=6
# Parquet row batch size for streaming materialization (default 16384).
# LEVIATHAN_HF_PARQUET_BATCH_ROWS=16384

# Optional web research search provider (requires outbound network).
# LEVIATHAN_WEB_SEARCH_ENDPOINT=
# LEVIATHAN_WEB_SEARCH_API_KEY=

# Force deterministic training fixture worker (no torch required).
# LEVIATHAN_TRAINING_FIXTURE=0

# Artifact bytes live on disk; metadata in SQLite.
LEVIATHAN_ARTIFACTS_ROOT=Data/backend/data/artifacts

# Local SQLite + artifact snapshots (Phase 39).
LEVIATHAN_BACKUP_ROOT=Data/backend/data/backups

# Context Engine token budgeting (chars/4 heuristic).
LEVIATHAN_CONTEXT_TOKEN_BUDGET=6000
LEVIATHAN_CONTEXT_RESERVE_RESPONSE_TOKENS=512
LEVIATHAN_CONTEXT_MAX_KNOWLEDGE_CHARS=1800

# Resource admission ceilings (Resource Manager / Job runtime).
LEVIATHAN_MAX_MODEL_CONCURRENCY=1
LEVIATHAN_MAX_FUNCTION_CONCURRENCY=2
LEVIATHAN_MAX_JOB_CONCURRENCY=1

# Network capability (disabled by default).
LEVIATHAN_NETWORK_ALLOW_OUTBOUND=false

# Chaos / resilience injection (Phase 41). Default OFF.
# Refused when LEVIATHAN_LOOPBACK_ONLY=false.
LEVIATHAN_CHAOS_ENABLED=false
LEVIATHAN_CHAOS_LATENCY_MS=0
LEVIATHAN_CHAOS_ERROR_RATE=0

# Feature flags (experimental; never bypass security).
LEVIATHAN_FEATURE_ITERATIVE_RETRIEVAL=false
LEVIATHAN_FEATURE_MEMORY_SEMANTIC=false
LEVIATHAN_FEATURE_NEURO=false
LEVIATHAN_FEATURE_NEURO_ASSOCIATIVE_MEMORY=false
LEVIATHAN_FEATURE_NEURO_PROCESS_CRITIC=false
LEVIATHAN_FEATURE_NEURO_RESIDUAL_INJECTION=false
LEVIATHAN_FEATURE_NEURO_CORTEX=false
LEVIATHAN_FEATURE_NEURO_MEMORY_TIERS=false
# Phase 53+ neuro children (require LEVIATHAN_FEATURE_NEURO=true)
LEVIATHAN_FEATURE_NEURO_RESIDUAL_ORCHESTRATOR=false
LEVIATHAN_FEATURE_NEURO_CORTEX_BLOCKS=false
LEVIATHAN_FEATURE_NEURO_CONTRASTIVE_TRAINING=false
LEVIATHAN_FEATURE_NEURO_SOAK_LONG=false
# EXTERNAL-FIRST ephemeral recipe worker (requires NEURO=true)
LEVIATHAN_NEURO_TRAINING_REAL_WORKER=false
LEVIATHAN_FEATURE_MODULE_MANAGER=false
LEVIATHAN_FEATURE_MODULE_MANAGER_SUBPROCESS=false
LEVIATHAN_FEATURE_AGENTS=false
# Coding Agent (requires AGENTS=true). Default OFF.
LEVIATHAN_FEATURE_CODING=false
# Universal MCP bridge (default OFF). Children require parent.
LEVIATHAN_FEATURE_MCP=false
# LEVIATHAN_FEATURE_MCP_STDIO=true
# LEVIATHAN_FEATURE_MCP_HTTP=true
# LEVIATHAN_FEATURE_MCP_AUTO_EXPAND_MODULES=true

# RAG V3 / Deep Recall / Why Library (children require RAG_V3=true). Default OFF.
LEVIATHAN_FEATURE_RAG_V3=false
LEVIATHAN_FEATURE_DEEP_RECALL=false
LEVIATHAN_FEATURE_WHY_LIBRARY=false
# Residual production path (requires NEURO + NEURO_RESIDUAL_INJECTION). Default OFF.
LEVIATHAN_FEATURE_RESIDUAL_PRODUCTION=false
# Chat SSE / token streaming (Phase 54). CHAT_SSE requires CHAT_STREAMING.
LEVIATHAN_FEATURE_CHAT_STREAMING=false
LEVIATHAN_FEATURE_CHAT_SSE=false

# Cognitive Runtime (Phase 55). Children require LEVIATHAN_FEATURE_COGNITION=true.
# Default OFF. Shadow mode observes without replacing chat answers.
LEVIATHAN_FEATURE_COGNITION=false
LEVIATHAN_FEATURE_COGNITION_SHADOW=false
LEVIATHAN_FEATURE_COGNITION_ITERATIVE_LOOP=false
LEVIATHAN_FEATURE_COGNITION_BELIEF_STATE=false
LEVIATHAN_FEATURE_COGNITION_NEURO=false
LEVIATHAN_FEATURE_COGNITION_ADAPTIVE_DEPTH=false
LEVIATHAN_FEATURE_COGNITION_DELEGATION=false
LEVIATHAN_FEATURE_COGNITION_EXPERIENCE_LEARNING=false

# Wave 0 durable kernel (leases takeover / advanced envelope emission). Contracts always exist.
LEVIATHAN_FEATURE_DURABLE_KERNEL=false

# Embedding / reranker (heavy deps optional — Core stays importable without them).
# Providers: null | hash | sentence_transformers
# When RAG_V3=true and unset, defaults to hash (deterministic local, no torch).
# LEVIATHAN_EMBEDDING_PROVIDER=hash
# LEVIATHAN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LEVIATHAN_EMBEDDING_HASH_DIMENSIONS=256
# Optional cross-encoder reranker (requires sentence-transformers):
# LEVIATHAN_RERANKER_MODEL=
LEVIATHAN_DEEP_RECALL_BUDGET=800

# Market simulation (paper / causal multi-agent). Default OFF.
LEVIATHAN_FEATURE_MARKET_SIM=false
# Optional override; default = {LEVIATHAN_DATA_ROOT}/markets
# LEVIATHAN_MARKETS_ROOT=D:/ModelData/markets
LEVIATHAN_MARKET_SIM_BARS_PER_SLICE=50
LEVIATHAN_MARKET_SIM_INITIAL_CASH=100000

# Coding workspace (Windows operator root preserved). Default:
LEVIATHAN_CODING_WORKSPACE=D:/leviathan/codingworkspace
LEVIATHAN_CODING_MAX_ROUNDS=12
LEVIATHAN_CODING_MAX_FILE_BYTES=1000000
LEVIATHAN_CODING_COMMAND_ALLOWLIST=python,python3,pytest,npm,npx,node,git
LEVIATHAN_CODING_TEMPERATURE=0.1
LEVIATHAN_CODING_TOKEN_BUDGET=24000
LEVIATHAN_CODING_RESERVE_RESPONSE_TOKENS=1024
LEVIATHAN_CODING_MAX_FILE_CHARS=8000

# Neuro residual runtime: unsupported | deterministic | hf | vllm | llama_cpp | trt
LEVIATHAN_NEURO_RESIDUAL_KIND=unsupported
# Optional HF model id/path when KIND=hf (config probe only unless LOAD_WEIGHTS=true)
# For vLLM: endpoint URL. For llama.cpp/TRT: model path or residual server URL.
LEVIATHAN_NEURO_RESIDUAL_MODEL=
LEVIATHAN_NEURO_RESIDUAL_DEVICE=cpu
# Optional explicit residual HTTP server (llama.cpp / TRT / vLLM plugin)
# LEVIATHAN_NEURO_RESIDUAL_SERVER_URL=http://127.0.0.1:8080
# High-memory / dev-only: load real HF weights for residual hooks (requires torch+transformers)
LEVIATHAN_NEURO_RESIDUAL_LOAD_WEIGHTS=false
# Comma-separated mid/late layer indices for orchestrator / adapters
# LEVIATHAN_NEURO_RESIDUAL_HOOK_LAYERS=8,16,24
LEVIATHAN_NEURO_CORTEX_MAX_K=2
LEVIATHAN_NEURO_MEMORY_TIER0_MAX_SLOTS=64
LEVIATHAN_NEURO_ABSORB_LIMIT=50

# ── Leviathan Studio AI / OmniRoute Editor Gateway ──────────────────────────
# Studio AI is separate from HADES Coding OmniRoute (coding LLM routing).
# Generation never mutates lv-editor-content.json; Accept promotes via upload.

# Master kill switch (Studio still boots; AI panel reports disabled).
# LEVIATHAN_EDITOR_AI_DISABLED=false

# Deterministic mock image/text provider for offline tests & UI. Labeled MOCK.
# Never present mock output as real AI. Default OFF.
LEVIATHAN_EDITOR_AI_MOCK=0
# LEVIATHAN_EDITOR_AI_MOCK_LATENCY_MS=40
# LEVIATHAN_EDITOR_AI_MOCK_FAIL=   # error | timeout | unsupported

# Optional OpenAI Images API-compatible endpoint (b64_json required; no URL fetch).
# LEVIATHAN_EDITOR_AI_IMAGE_ENDPOINT=https://api.openai.com/v1/images/generations
# LEVIATHAN_EDITOR_AI_IMAGE_API_KEY=
# LEVIATHAN_EDITOR_AI_IMAGE_MODEL=dall-e-3

# Optional text rewrite / layout propose via OpenAI-compatible chat.
# Falls back to LEVIATHAN_LLM_* when unset.
# LEVIATHAN_EDITOR_AI_LLM_BASE_URL=http://127.0.0.1:1234/v1
# LEVIATHAN_EDITOR_AI_LLM_API_KEY=
# LEVIATHAN_EDITOR_AI_LLM_MODEL=

LEVIATHAN_EDITOR_AI_TIMEOUT_SECONDS=90
