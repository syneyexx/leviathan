{
  "format": 1,
  "id": "vibe-trading",
  "name": "Vibe-Trading",
  "version": "0.1.0",
  "description": "Personal trading research agent for HADES: web UI on :8899, CLI research runs, and research-only MCP tools. Prefer local LM Studio via LANGCHAIN_* env. Upstream: HKUDS/Vibe-Trading.",
  "runtime_type": "python",
  "entrypoint": "hades_bridge.py",
  "plugin_type": "service",
  "category": "Finance",
  "labels": [
    "trading",
    "backtest",
    "finance",
    "mcp",
    "lm-studio",
    "research"
  ],
  "permissions": [
    "subprocess",
    "filesystem",
    "network"
  ],
  "autonomous": false,
  "hades_api": ">=0.4.1",
  "source": "https://github.com/HKUDS/Vibe-Trading",
  "license": "MIT",
  "mcp": {
    "expand_tools": true
  },
  "healthcheck": {
    "type": "http",
    "url": "http://127.0.0.1:8899/",
    "method": "GET",
    "expected_status": [
      200,
      301,
      302,
      304
    ],
    "timeout_seconds": 240,
    "interval_seconds": 2.0
  },
  "dependency_install": {
    "timeout_seconds": 3600,
    "stall_timeout_seconds": 1800
  },
  "tools": [
    {
      "name": "doctor",
      "action": "doctor",
      "command": [
        "{python}",
        "hades_bridge.py",
        "doctor"
      ],
      "description": "Check vibe-trading-ai install and report UI/MCP entrypoints.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "write_files",
          "subprocess",
          "service",
          "mcp"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network",
          "healthcheck"
        ]
      }
    },
    {
      "name": "start",
      "action": "start",
      "mode": "service",
      "command": [
        "{python}",
        "serve_entrypoint.py"
      ],
      "env": {
        "LANGCHAIN_PROVIDER": "openai",
        "LANGCHAIN_BASE_URL": "http://127.0.0.1:1234/v1",
        "LANGCHAIN_API_KEY": "lm-studio"
      },
      "description": "Start Vibe-Trading FastAPI web UI on http://127.0.0.1:8899 (configure model via Settings/env).",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "write_files",
          "subprocess",
          "service",
          "mcp"
        ],
        "side_effect_class": "process",
        "cost_class": "expensive",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network",
          "healthcheck"
        ]
      }
    },
    {
      "name": "health",
      "action": "health",
      "mode": "command",
      "description": "Run declared healthcheck.",
      "command": "",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
