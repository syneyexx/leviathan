    {
      "name": "research",
      "action": "run",
      "command": [
        "{python}",
        "hades_bridge.py",
        "research",
        "--prompt",
        "{prompt}",
        "--timeout",
        "{timeout}"
      ],
      "description": "Run one Vibe-Trading research/backtest prompt via CLI (local LLM preferred).",
      "input_schema": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 3,
            "maxLength": 8000
          },
          "timeout": {
            "type": "integer",
            "default": 600,
            "minimum": 30,
            "maximum": 3600
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "write_files",
          "subprocess",
          "service",
          "mcp"
        ],
        "side_effect_class": "process",
        "cost_class": "expensive",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network",
          "healthcheck"
        ]
      }
    },
    {
      "name": "list_tools",
      "action": "list",
      "mode": "command",
      "command": [
        "{python}",
        "hades_bridge.py",
        "mcp",
        "--action",
        "list_tools",
        "--timeout",
        "90"
      ],
      "description": "List research-only MCP tools exposed by vibe-trading-mcp.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "write_files",
          "subprocess",
          "service",
          "mcp"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network",
          "healthcheck"
        ]
      }
    },
    {
      "name": "call_tool",
      "action": "call",
      "mode": "command",
      "command": [
        "{python}",
        "hades_bridge.py",
        "mcp",
        "--action",
        "call_tool",
        "--tool",
        "{tool}",
        "--arguments",
        "{arguments}",
        "--timeout",
        "180"
      ],
      "description": "Call one Vibe-Trading MCP research tool with JSON arguments.",
      "input_schema": {
        "type": "object",
        "required": [
          "tool"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "arguments": {
            "type": "string",
            "default": "{}",
            "description": "JSON object string"
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "write_files",
          "subprocess",
          "service",
          "mcp"
        ],
        "side_effect_class": "process",
        "cost_class": "expensive",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network",
          "healthcheck"
        ]
      }
    }
  ],
  "isolation": "restricted_env",
  "capabilities": {
    "effects": [
      "network",
      "read_files",
      "write_files",
      "subprocess",
      "service",
      "mcp"
    ],
    "side_effect_class": "process",
    "cost_class": "expensive",
    "latency_class": "slow",
    "failure_modes": [
      "dependency",
      "schema",
      "timeout",
      "network",
      "healthcheck"
    ]
  },
  "trust_default": "untrusted",
  "marketplace": {
    "pinned_version": "0.1.0",
    "source_url": "https://github.com/HKUDS/Vibe-Trading",
    "signed": false,
    "license": "MIT"
  }
}
