        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "write_files",
          "subprocess",
          "service",
          "mcp"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
