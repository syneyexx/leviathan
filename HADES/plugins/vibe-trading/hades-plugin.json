        ]
      }
    },
    {
      "name": "stop",
      "action": "stop",
      "mode": "command",
      "description": "Stop managed service.",
      "command": "",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
