{
  "id": "graft",
  "name": "Graft",
  "description": "Local import/symbol graph so HADES can navigate a codebase cheaper than dumping whole files.",
  "runtime_type": "python",
  "entrypoint": "hades_bridge.py",
  "plugin_type": "tool",
  "category": "Developer",
  "labels": [
    "code-graph",
    "context"
  ],
  "permissions": [
    "subprocess",
    "filesystem"
  ],
  "autonomous": true,
  "source": "https://github.com/trailhq/Graft",
  "tools": [
    {
      "name": "doctor",
      "action": "doctor",
      "mode": "command",
      "description": "Confirm the local graph bridge.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "doctor"
      ],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "index",
      "action": "index",
      "mode": "command",
      "description": "Build an import graph JSON for a source root.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "index",
        "--root",
        "{root}",
        "--output",
        "{output}",
        "--limit",
        "{limit}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "output": {
            "type": "string",
            "default": "graft-graph.json",
            "maxLength": 300
          },
          "limit": {
            "type": "integer",
            "default": 4000,
            "minimum": 10,
            "maximum": 20000
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "read_files",
          "write_files"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      },
      "autonomous": false
    },
    {
      "name": "neighbors",
      "action": "query",
      "mode": "command",
      "description": "Show imports / imported-by for a file in the graph.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "neighbors",
        "--graph",
        "{graph}",
        "--file",
        "{file}",
        "--limit",
        "{limit}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "graph": {
            "type": "string",
            "default": "graft-graph.json",
            "maxLength": 300
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "limit": {
            "type": "integer",
            "default": 40,
            "minimum": 1,
            "maximum": 200
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "read_files"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "search",
      "action": "search",
      "mode": "command",
      "description": "Search the import graph for a symbol or path fragment.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "search",
        "--graph",
        "{graph}",
        "--query",
        "{query}",
        "--limit",
        "{limit}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "graph": {
            "type": "string",
            "default": "graft-graph.json",
            "maxLength": 300
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "read_files"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    }
  ],
  "knowledge_paths": [
    "README.md"
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "hades_api": ">=0.4.1",
  "version": "0.1.0",
  "format": 1,
  "capabilities": {
    "effects": [
      "read_files",
      "write_files",
      "subprocess"
    ],
    "side_effect_class": "process",
    "cost_class": "cheap",
    "latency_class": "fast",
    "failure_modes": [
      "dependency",
      "schema",
      "timeout"
    ]
  },
  "marketplace": {
    "pinned_version": "0.1.0",
    "source_url": "https://github.com/trailhq/Graft",
    "signed": false,
    "license": "MIT"
  },
  "license": "MIT"
}
