{
  "format": 1,
  "id": "gods-eye-view",
  "name": "God's Eye View",
  "version": "0.1.1",
  "description": "Photorealistic 3D globe with live open-source spatial intelligence: aircraft, ships, satellites, earthquakes, public cameras and more. Upstream: bilawalsidhu/gods-eye-view (MIT). Starts a local Vite app on http://127.0.0.1:4173. Requires Node.js 24.14+ or 26.x. Optional API keys (Cesium, Google Maps, OpenAI) are configured inside the app POWER UP panel.",
  "runtime_type": "node",
  "entrypoint": "dev",
  "plugin_type": "service",
  "category": "Research",
  "labels": [
    "globe",
    "geospatial",
    "spatial-intelligence",
    "node"
  ],
  "permissions": [
    "subprocess"
  ],
  "autonomous": false,
  "hades_api": ">=0.4.1",
  "source": "https://github.com/bilawalsidhu/gods-eye-view",
  "license": "MIT",
  "upstream_author": "Bilawal Sidhu",
  "healthcheck": {
    "type": "http",
    "url": "http://127.0.0.1:4173/",
    "method": "GET",
    "expected_status": [
      200
    ],
    "timeout_seconds": 90,
    "interval_seconds": 1.0
  },
  "tools": [
    {
      "name": "doctor",
      "action": "doctor",
      "mode": "command",
      "description": "Run the God's Eye View setup doctor (Node version and environment checks).",
      "command": [
        "{npm}",
        "run",
        "doctor"
      ],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "service",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "start",
      "action": "start",
      "mode": "service",
      "description": "Start the local God's Eye View Vite server on http://127.0.0.1:4173. Open that URL in your browser after health passes.",
      "command": [
        "{npm}",
        "run",
        "dev"
      ],
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "4173"
