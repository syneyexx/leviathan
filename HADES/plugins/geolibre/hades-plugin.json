    }
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "capabilities": {
    "effects": [
      "network",
      "service",
      "subprocess"
    ],
    "side_effect_class": "process",
    "cost_class": "moderate",
    "latency_class": "slow",
    "failure_modes": [
      "dependency",
      "healthcheck",
      "network",
      "schema",
      "timeout"
    ]
  },
  "marketplace": {
    "pinned_version": "0.2.0",
    "source_url": "https://github.com/opengeos/GeoLibre",
