        ]
      }
    },
    {
      "name": "stop",
      "action": "stop",
      "autonomous": false,
      "mode": "command",
      "description": "Stop the managed GeoLibre service and verify that its HTTP healthcheck is no longer reachable.",
      "command": "",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
