{
  "format": 1,
  "id": "geolibre",
  "name": "GeoLibre",
  "version": "0.2.0",
  "description": "GeoLibre geospatial platform for HADES: local Vite map UI plus offline-first tools that load GeoJSON datasets, analyze properties/geometry, run bbox/property/spatial queries, and return structured JSON (with hades_knowledge evidence) the Chat/Work Runtime can reuse. Upstream UI: opengeos/GeoLibre v2.9.0 (MIT) on http://127.0.0.1:5173 (Node.js 22+). Data tools use a stdlib Python adapter and do not require the UI or network.",
  "runtime_type": "node",
  "entrypoint": "dev",
  "plugin_type": "service",
  "category": "Research",
  "labels": [
    "gis",
    "geospatial",
    "geojson",
    "mapping",
    "spatial-query",
    "node"
  ],
  "permissions": [
    "subprocess",
    "network"
  ],
  "autonomous": true,
  "hades_api": ">=0.4.1",
  "source": "https://github.com/opengeos/GeoLibre",
  "license": "MIT",
  "upstream_author": "Qiusheng Wu / opengeos",
  "upstream_version": "2.9.0",
  "upstream_ref": "cf02ccd881a3bc7b72f1af68a668dddffa0ffd7d",
  "healthcheck": {
    "type": "http",
    "url": "http://127.0.0.1:5173/",
    "method": "GET",
    "expected_status": [
      200
    ],
    "timeout_seconds": 120,
    "interval_seconds": 1.0
  },
  "tools": [
    {
      "name": "geolibre_inspect",
      "action": "inspect",
      "autonomous": true,
      "knowledge_output": "hades_knowledge",
      "description": "Inspect a local GeoJSON file, inline GeoJSON, or previously loaded dataset: feature counts, geometry types, bbox, property schema and sample features. Offline-only; remote URLs are rejected.",
      "command": [
        "{python}",
        "geolibre_hades.py",
        "inspect",
        "--path",
        "{path}",
        "--geojson",
        "{geojson}",
        "--dataset-id",
        "{dataset_id}",
        "--sample-limit",
        "{sample_limit}"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "default": "",
            "maxLength": 1000
          },
          "geojson": {
            "type": [
              "string",
              "object"
            ],
            "default": ""
          },
          "dataset_id": {
            "type": "string",
            "default": "",
            "maxLength": 80
          },
          "sample_limit": {
            "type": "integer",
            "default": 5,
            "minimum": 0,
            "maximum": 25
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "capabilities": {
        "effects": [
          "network",
          "service",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "geolibre_analyze",
      "action": "analyze",
      "autonomous": true,
      "knowledge_output": "hades_knowledge",
      "description": "Analyze GeoJSON geometry distribution, bbox and numeric property statistics for a local file, inline GeoJSON or loaded dataset. Returns structured JSON HADES can reuse.",
      "command": [
        "{python}",
        "geolibre_hades.py",
        "analyze",
        "--path",
        "{path}",
        "--geojson",
        "{geojson}",
        "--dataset-id",
        "{dataset_id}"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "default": "",
            "maxLength": 1000
          },
          "geojson": {
            "type": [
              "string",
              "object"
            ],
            "default": ""
          },
          "dataset_id": {
            "type": "string",
            "default": "",
            "maxLength": 80
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "capabilities": {
        "effects": [
          "network",
          "service",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "geolibre_load",
      "action": "load",
      "autonomous": true,
      "knowledge_output": "hades_knowledge",
      "description": "Persist a local GeoJSON file or inline FeatureCollection under a dataset_id so later inspect/analyze/query calls can reuse it without re-sending the full payload.",
      "command": [
        "{python}",
        "geolibre_hades.py",
        "load",
        "--dataset-id",
        "{dataset_id}",
        "--path",
        "{path}",
        "--geojson",
        "{geojson}",
        "--title",
        "{title}"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id"
        ],
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "path": {
            "type": "string",
            "default": "",
            "maxLength": 1000
          },
          "geojson": {
            "type": [
              "string",
              "object"
            ],
            "default": ""
          },
          "title": {
            "type": "string",
            "default": "",
            "maxLength": 200
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "capabilities": {
        "effects": [
          "network",
          "service",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "geolibre_list",
      "action": "list",
      "autonomous": true,
      "description": "List datasets previously loaded into the GeoLibre HADES data store.",
      "command": [
        "{python}",
        "geolibre_hades.py",
        "list"
      ],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "capabilities": {
        "effects": [
          "network",
          "service",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "geolibre_query",
      "action": "query",
      "autonomous": true,
      "knowledge_output": "hades_knowledge",
      "description": "Run a bounded spatial/attribute query over GeoJSON: bbox intersection, property filters, geometry type filter, polygon contains-point, or distance-from-point. Returns a capped Feature list plus hades_knowledge evidence for programmatic reuse.",
      "command": [
        "{python}",
        "geolibre_hades.py",
        "query",
        "--path",
        "{path}",
        "--geojson",
        "{geojson}",
        "--dataset-id",
        "{dataset_id}",
        "--bbox",
        "{bbox}",
        "--where",
        "{where}",
        "--geometry-types",
        "{geometry_types}",
        "--contains-point",
        "{contains_point}",
        "--within-distance",
        "{within_distance}",
        "--limit",
        "{limit}",
        "--max-bytes",
        "{max_bytes}"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "default": "",
            "maxLength": 1000
          },
          "geojson": {
            "type": [
              "string",
              "object"
            ],
            "default": ""
          },
          "dataset_id": {
            "type": "string",
            "default": "",
            "maxLength": 80
          },
          "bbox": {
            "type": [
              "array",
              "string",
              "null"
            ],
            "default": "",
            "description": "[minLon, minLat, maxLon, maxLat] or JSON string"
          },
          "where": {
            "type": [
              "object",
              "string",
              "null"
            ],
            "default": "",
            "description": "Property filter object, e.g. {\"name\":{\"contains\":\"Amster\"}} or {\"pop\":{\"gte\":1000}}"
          },
          "geometry_types": {
            "type": [
              "array",
              "string",
              "null"
            ],
            "default": "",
            "description": "Optional list such as [\"Point\",\"Polygon\"]"
          },
          "contains_point": {
            "type": [
              "array",
              "string",
              "null"
            ],
            "default": "",
            "description": "[lon, lat] kept only by polygon features that contain the point"
          },
          "within_distance": {
            "type": [
              "object",
              "string",
              "null"
            ],
            "default": "",
            "description": "{\"point\":[lon,lat],\"meters\":1000} using feature centroid distance"
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 500
          },
          "max_bytes": {
            "type": "integer",
            "default": 250000,
            "minimum": 1,
            "maximum": 2000000
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "capabilities": {
        "effects": [
          "network",
          "service",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "doctor",
      "action": "doctor",
      "autonomous": false,
      "mode": "command",
      "description": "Verify that the installed Node.js runtime satisfies GeoLibre's Node.js 22+ requirement.",
      "command": [
        "node",
        "-e",
        "const major=Number(process.versions.node.split('.')[0]); if(major<22){console.error('GeoLibre requires Node.js >=22; found '+process.versions.node); process.exit(1)} console.log('Node '+process.versions.node+' OK for GeoLibre')"
      ],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "service",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "start",
      "action": "start",
      "autonomous": false,
      "mode": "service",
      "description": "Start GeoLibre's local Vite web app on http://127.0.0.1:5173. The first start may build prerequisite web assets before Vite becomes healthy.",
      "command": [
        "{npm}",
        "run",
        "dev",
        "-w",
        "geolibre-desktop",
        "--",
        "--host",
        "127.0.0.1"
      ],
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "5173"
      },
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "service",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "expensive",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "health",
      "action": "health",
      "autonomous": false,
      "mode": "command",
      "description": "Check whether the local GeoLibre HTTP service answers on port 5173.",
      "command": "",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "service",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "status",
      "action": "status",
      "autonomous": false,
      "mode": "command",
      "description": "Report managed-process and HTTP health status for GeoLibre.",
      "command": "",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "service",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "logs",
      "action": "logs",
      "autonomous": false,
      "mode": "command",
      "description": "Read persisted stdout/stderr from the managed GeoLibre service.",
      "command": "",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "service",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
