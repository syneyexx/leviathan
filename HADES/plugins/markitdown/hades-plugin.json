{
  "format": 1,
  "id": "markitdown",
  "name": "MarkItDown",
  "version": "0.1.0",
  "description": "Convert documents (PDF, Office, HTML, and more) to Markdown for LLM pipelines. Upstream: microsoft/markitdown.",
  "runtime_type": "python",
  "entrypoint": "hades_bridge.py",
  "plugin_type": "tool",
  "category": "Data",
  "labels": [
    "markdown",
    "conversion",
    "documents"
  ],
  "permissions": [
    "subprocess",
    "filesystem"
  ],
  "autonomous": true,
  "hades_api": ">=0.4.1",
  "source": "https://github.com/microsoft/markitdown",
  "license": "MIT",
  "tools": [
    {
      "name": "doctor",
      "action": "doctor",
      "command": [
        "{python}",
        "hades_bridge.py",
        "doctor"
      ],
      "description": "Check whether MarkItDown is importable in the plugin venv.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "read_files",
          "subprocess",
          "write_files"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "convert",
      "action": "convert",
      "command": [
        "{python}",
        "hades_bridge.py",
        "convert",
        "--path",
        "{path}",
        "--output",
        "{output}"
      ],
      "description": "Convert a local file to Markdown via MarkItDown.",
      "input_schema": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string",
            "default": ""
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "read_files",
          "subprocess",
          "write_files"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    }
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "capabilities": {
    "effects": [
      "read_files",
      "subprocess",
      "write_files"
    ],
    "side_effect_class": "process",
    "cost_class": "cheap",
    "latency_class": "fast",
    "failure_modes": [
      "dependency",
      "schema",
      "timeout"
    ]
  },
  "marketplace": {
    "pinned_version": "0.1.0",
    "source_url": "https://github.com/microsoft/markitdown",
    "license": "MIT",
    "signed": false
  }
}
