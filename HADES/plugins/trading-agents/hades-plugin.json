{
  "id": "trading-agents",
  "name": "Trading Agents",
  "description": "Paper-only multi-agent market debate (analyst/bull/bear/trader/risk) via LM Studio. Never places live orders.",
  "runtime_type": "python",
  "entrypoint": "hades_bridge.py",
  "plugin_type": "tool",
  "category": "Finance",
  "labels": [
    "trading",
    "paper",
    "multi-agent"
  ],
  "permissions": [
    "subprocess",
    "network",
    "filesystem"
  ],
  "autonomous": true,
  "source": "https://github.com/TauricResearch/TradingAgents",
  "tools": [
    {
      "name": "doctor",
      "action": "doctor",
      "mode": "command",
      "description": "List paper roles and LM client status.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "doctor"
      ],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "prepare",
      "action": "prepare",
      "mode": "command",
      "description": "Build a paper debate brief for a ticker.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "prepare",
        "--ticker",
        "{ticker}",
        "--notes",
        "{notes}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "ticker"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "notes": {
            "type": "string",
            "default": "",
            "maxLength": 8000
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "run_round",
      "action": "run",
      "mode": "command",
      "description": "Run a paper debate round on LM Studio. Fails closed if the model endpoint is down.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "run_round",
        "--ticker",
        "{ticker}",
        "--notes",
        "{notes}",
        "--model",
        "{model}",
        "--base-url",
        "{base_url}",
        "--api-key",
        "{api_key}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "ticker",
          "model"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "notes": {
            "type": "string",
            "default": "",
            "maxLength": 8000
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "base_url": {
            "type": "string",
            "default": "",
            "maxLength": 400
          },
          "api_key": {
            "type": "string",
            "default": "",
            "maxLength": 400
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "network",
          "write_files"
        ],
        "side_effect_class": "process",
        "cost_class": "expensive",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network"
        ]
      },
      "autonomous": false
    }
  ],
  "knowledge_paths": [
    "README.md"
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "hades_api": ">=0.4.1",
  "version": "0.1.0",
  "format": 1,
  "capabilities": {
    "effects": [
      "network",
      "read_files",
      "write_files",
      "subprocess"
    ],
    "side_effect_class": "process",
    "cost_class": "cheap",
    "latency_class": "fast",
    "failure_modes": [
      "dependency",
      "schema",
      "timeout",
      "network"
    ]
  },
  "marketplace": {
    "pinned_version": "0.1.0",
    "source_url": "https://github.com/TauricResearch/TradingAgents",
    "signed": false,
    "license": "Apache-2.0"
  },
  "license": "Apache-2.0"
}
