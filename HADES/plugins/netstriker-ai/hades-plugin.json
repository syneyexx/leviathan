{
  "format": 1,
  "id": "netstriker-ai",
  "name": "NetStrikerAI",
  "version": "0.1.0",
  "description": "HADES wrapper for TechXplorevo/Netstriker.ai: offline port remediation + DPDP mapping, target resolve, and authorized local-only Nmap scans (private/loopback). Does not start the full MongoDB web UI or scan public hosts without NetStriker domain verification.",
  "runtime_type": "python",
  "entrypoint": "hades_bridge.py",
  "plugin_type": "tool",
  "category": "Security",
  "labels": [
    "vulnerability",
    "nmap",
    "remediation",
    "dpdp",
    "netstriker"
  ],
  "permissions": [
    "subprocess",
    "network"
  ],
  "autonomous": false,
  "hades_api": ">=0.4.1",
  "source": "https://github.com/TechXplorevo/Netstriker.ai",
  "license": "Upstream project terms — see NetStrikerAI README",
  "dependency_install": {
    "timeout_seconds": 900,
    "stall_timeout_seconds": 300
  },
  "tools": [
    {
      "name": "doctor",
      "action": "doctor",
      "command": [
        "{python}",
        "hades_bridge.py",
        "doctor"
      ],
      "description": "Check NetStrikerAI bridge layout, python-nmap/pydantic imports, and nmap binary availability.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "list_remediation",
      "action": "list",
      "command": [
        "{python}",
        "hades_bridge.py",
        "list_remediation",
        "--limit",
        "{limit}"
      ],
      "description": "List offline port/service remediation guidance from NetStrikerAI.",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 200,
            "minimum": 1,
            "maximum": 500
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "get_remediation",
      "action": "get",
      "command": [
        "{python}",
        "hades_bridge.py",
        "get_remediation",
        "--port",
        "{port}",
        "--service",
        "{service}"
      ],
      "description": "Get remediation steps for one TCP port/service.",
      "input_schema": {
        "type": "object",
        "required": [
          "port"
        ],
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "service": {
            "type": "string",
            "default": "",
            "maxLength": 64
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "dpdp_map",
      "action": "map",
      "command": [
        "{python}",
        "hades_bridge.py",
        "dpdp_map",
        "--risk",
        "{risk}"
      ],
      "description": "Map a risk label (high/medium/low) to India's DPDP Act guidance from NetStrikerAI.",
      "input_schema": {
        "type": "object",
        "properties": {
          "risk": {
            "type": "string",
            "default": "medium",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "resolve_target",
      "action": "resolve",
      "command": [
        "{python}",
        "hades_bridge.py",
        "resolve_target",
        "--target",
        "{target}"
      ],
      "description": "Resolve a hostname/URL/IP and report whether it is a private/loopback auto-safe target.",
      "input_schema": {
        "type": "object",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "scan_local",
      "action": "scan",
      "command": [
        "{python}",
        "hades_bridge.py",
        "scan_local",
        "--target",
        "{target}",
        "--authorized",
        "{authorized}"
      ],
      "description": "Authorized Nmap TCP/service (+NSE vuln) scan for private/loopback targets only. Requires authorized=true.",
      "input_schema": {
        "type": "object",
        "required": [
          "target",
          "authorized"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "description": "Private/loopback IP or hostname that resolves to one."
          },
          "authorized": {
            "type": "string",
            "enum": [
              "true"
            ],
            "description": "Must be the string true to confirm you own/control the target."
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    }
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "capabilities": {
    "effects": [
      "network",
      "subprocess"
    ],
    "side_effect_class": "process",
    "cost_class": "moderate",
    "latency_class": "normal",
    "failure_modes": [
      "dependency",
      "network",
      "schema",
      "timeout"
    ]
  },
  "marketplace": {
    "pinned_version": "0.1.0",
    "source_url": "https://github.com/TechXplorevo/Netstriker.ai",
    "license": "Upstream project terms — see NetStrikerAI README",
    "signed": false
  }
}
