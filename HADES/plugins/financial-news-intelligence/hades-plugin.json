          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "open_terminal",
      "action": "launch",
      "command": [
        "{python}",
        "financial_news_intelligence.py",
        "terminal"
      ],
      "description": "Open an OS terminal in the plugin directory for manual runs or source debugging.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    }
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "capabilities": {
    "effects": [
      "network",
      "read_files",
      "subprocess"
    ],
    "side_effect_class": "process",
    "cost_class": "moderate",
    "latency_class": "normal",
