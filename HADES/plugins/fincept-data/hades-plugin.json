{
  "format": 1,
  "id": "fincept-data",
  "name": "Fincept Data",
  "version": "0.1.0",
  "description": "Native HADES adapter for Fincept Data API. Provides secure read-only autonomous access, documentation discovery, provenance-rich evidence, and manual POST access for analytics/QuantLib endpoints without embedding credentials.",
  "runtime_type": "python",
  "entrypoint": "fincept_hades.py",
  "plugin_type": "tool",
  "category": "Research",
  "labels": [
    "Fincept",
    "Market Data",
    "Research",
    "Economics",
    "Evidence"
  ],
  "permissions": [
    "subprocess",
    "network"
  ],
  "autonomous": true,
  "hades_api": ">=0.4.1",
  "source": "https://github.com/Fincept-Corporation/FinceptTerminal",
  "configuration": {
    "required_env": [
      "FINCEPT_API_KEY"
    ],
    "optional_env": [
      "FINCEPT_SESSION_TOKEN"
    ],
    "api_base": "https://api.fincept.in",
    "docs_index": "https://docs.fincept.in/llms.txt"
  },
  "tools": [
    {
      "name": "fincept_catalog",
      "action": "catalog",
      "autonomous": true,
      "description": "Search Fincept's official documentation index for endpoint/capability pages before choosing an API path. No API key is sent.",
      "command": [
        "{python}",
        "fincept_hades.py",
        "catalog",
        "--query",
        "{query}",
        "--limit",
        "{limit}",
        "--timeout",
        "{timeout}"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "default": "",
            "maxLength": 300
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          },
          "timeout": {
            "type": "integer",
            "default": 20,
            "minimum": 3,
            "maximum": 60
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "capabilities": {
        "effects": [
          "network",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "expensive",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "fincept_get",
      "action": "get",
      "autonomous": true,
      "knowledge_output": "hades_knowledge",
      "description": "Read data from a relative Fincept API endpoint using GET. Host is pinned to api.fincept.in; account/auth/billing/admin paths are blocked. Returns source URI, retrieval time, rate-limit state and a HADES evidence envelope.",
      "command": [
        "{python}",
        "fincept_hades.py",
        "get",
        "--path",
        "{path}",
        "--query",
        "{query}",
        "--max-bytes",
        "{max_bytes}",
        "--timeout",
        "{timeout}"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500,
            "pattern": "^/[^/?#]*"
          },
          "query": {
            "type": "object",
            "default": {}
          },
          "max_bytes": {
            "type": "integer",
            "default": 250000,
            "minimum": 1,
            "maximum": 2000000
          },
          "timeout": {
            "type": "integer",
            "default": 30,
            "minimum": 3,
            "maximum": 60
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "capabilities": {
        "effects": [
          "network",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "fincept_batch_get",
      "action": "batch-get",
      "autonomous": false,
      "knowledge_output": "hades_knowledge",
      "description": "Manually fetch up to five Fincept GET endpoints in one bounded batch. Intended for curated evidence packs; disabled for autonomous selection to control API credits and rate limits.",
      "command": [
        "{python}",
        "fincept_hades.py",
        "batch-get",
        "--batch",
        "{batch}",
        "--max-bytes",
        "{max_bytes}",
        "--timeout",
        "{timeout}"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batch"
        ],
        "properties": {
          "batch": {
            "type": "object"
          },
          "max_bytes": {
            "type": "integer",
            "default": 250000,
            "minimum": 1,
            "maximum": 2000000
          },
          "timeout": {
            "type": "integer",
            "default": 30,
            "minimum": 3,
            "maximum": 60
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "capabilities": {
        "effects": [
          "network",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "fincept_post",
      "action": "post",
      "autonomous": false,
      "knowledge_output": "hades_knowledge",
      "description": "Manually call Fincept POST endpoints such as analytics/QuantLib with a JSON body. Disabled for autonomous selection because POST calls can consume credits or trigger expensive computations.",
      "command": [
        "{python}",
        "fincept_hades.py",
        "post",
        "--path",
        "{path}",
        "--query",
        "{query}",
        "--body",
        "{body}",
        "--max-bytes",
        "{max_bytes}",
        "--timeout",
        "{timeout}"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "body"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500,
            "pattern": "^/[^/?#]*"
          },
          "query": {
            "type": "object",
            "default": {}
          },
          "body": {
            "type": "object"
          },
          "max_bytes": {
            "type": "integer",
            "default": 250000,
            "minimum": 1,
            "maximum": 2000000
          },
          "timeout": {
            "type": "integer",
            "default": 30,
            "minimum": 3,
            "maximum": 60
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "capabilities": {
        "effects": [
          "network",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "fincept_doctor",
      "action": "status",
      "autonomous": false,
      "description": "Check Fincept plugin configuration without revealing credentials. Optional probe verifies /user/profile connectivity but never prints profile data or the API key.",
      "command": [
        "{python}",
        "fincept_hades.py",
        "doctor",
        "--probe",
        "{probe}",
        "--max-bytes",
        "{max_bytes}",
        "--timeout",
        "{timeout}"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "probe": {
            "type": "boolean",
            "default": false
          },
          "max_bytes": {
            "type": "integer",
            "default": 100000,
            "minimum": 1,
            "maximum": 100000
          },
          "timeout": {
            "type": "integer",
            "default": 20,
            "minimum": 3,
            "maximum": 60
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "capabilities": {
        "effects": [
          "network",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    }
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "capabilities": {
    "effects": [
      "network",
      "subprocess"
    ],
    "side_effect_class": "process",
    "cost_class": "moderate",
    "latency_class": "normal",
    "failure_modes": [
      "dependency",
      "network",
      "schema",
      "timeout"
    ]
  },
  "marketplace": {
    "pinned_version": "0.1.0",
    "source_url": "https://github.com/Fincept-Corporation/FinceptTerminal",
    "signed": false
  }
}
