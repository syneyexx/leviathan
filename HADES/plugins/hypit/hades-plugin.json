{
  "format": 1,
  "id": "hypit",
  "name": "Hypit",
  "version": "0.1.0",
  "description": "HADES plugin for hypit-ai/hypit: clone and author videos as SVML workflows. Chat can load the Hypit skill/playbooks immediately; prepare installs the real hypit CLI (@hypit/hypit) so check/plan/runtime/media/build run through Plugin Manager.",
  "runtime_type": "python",
  "entrypoint": "hades_bridge.py",
  "plugin_type": "tool",
  "category": "Media",
  "labels": [
    "video",
    "svml",
    "hypit",
    "ugc",
    "captions",
    "agent"
  ],
  "permissions": [
    "subprocess",
    "filesystem",
    "network"
  ],
  "autonomous": true,
  "hades_api": ">=0.4.1",
  "source": "https://github.com/hypit-ai/hypit",
  "license": "Hypit Open Source License (Apache-2.0 additional conditions)",
  "upstream_author": "Hypit.AI",
  "upstream_version": "0.1.9",
  "knowledge_paths": [
    "README.md",
    "skills",
    "fixtures",
    "docs"
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "tools": [
    {
      "name": "doctor",
      "action": "doctor",
      "mode": "command",
      "description": "Check Hypit skill files, Node, and whether the hypit CLI is installed for HADES.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "doctor"
      ],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "read",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "prepare",
      "action": "install",
      "mode": "command",
      "description": "Install the @hypit/hypit executable into the plugin vendor dir via npm (network, first run). Skips Chromium download. No-op if CLI already works.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "prepare",
        "--pin",
        "{pin}"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "pin": {
            "type": "string",
            "default": "0.1.9",
            "maxLength": 32
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "network",
          "write_files"
        ],
        "side_effect_class": "network",
        "cost_class": "expensive",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "network",
          "timeout",
          "schema"
        ]
      },
      "autonomous": false
    },
    {
      "name": "list_skills",
      "action": "list",
      "mode": "command",
      "description": "List Hypit agent skill and reference documents packaged with this plugin.",
      "command": [
        "{python}",
        "skill_bridge.py",
        "list",
        "--limit",
        "{limit}"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 200,
            "minimum": 1,
            "maximum": 1000
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "read",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "schema",
          "timeout"
        ]
      },
      "metadata": {
        "static_knowledge": true,
        "action": "list"
      }
    },
