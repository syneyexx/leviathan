        ]
      }
    },
    {
      "name": "stop",
      "action": "stop",
      "mode": "command",
      "description": "Stop managed service.",
      "command": "",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "service",
          "subprocess",
          "write_files"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "network",
          "schema",
          "timeout"
        ]
      }
    }
  ],
  "isolation": "restricted_env",
  "trust_default": "untrusted",
  "capabilities": {
    "effects": [
      "network",
      "read_files",
      "service",
      "subprocess",
      "write_files"
    ],
    "side_effect_class": "process",
    "cost_class": "moderate",
    "latency_class": "slow",
    "failure_modes": [
      "dependency",
      "healthcheck",
      "network",
      "schema",
      "timeout"
    ]
  },
  "marketplace": {
    "pinned_version": "0.1.0",
    "source_url": "https://github.com/headroomlabs-ai/headroom",
    "license": "Apache-2.0",
    "signed": false
