          "write_files"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "logs",
      "action": "logs",
      "mode": "command",
