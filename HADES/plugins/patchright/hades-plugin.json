{
  "format": 1,
  "id": "patchright",
  "name": "Patchright",
  "version": "0.1.0",
  "description": "Stealth Playwright drop-in for HADES research browsing: fetch and screenshot pages that block vanilla automation. Upstream: Kaliiiiiiiiii-Vinyzu/patchright (Python package patchright).",
  "runtime_type": "python",
  "entrypoint": "hades_bridge.py",
  "plugin_type": "tool",
  "category": "Browser",
  "labels": [
    "patchright",
    "playwright",
    "browser",
    "stealth",
    "screenshot"
  ],
  "permissions": [
    "subprocess",
    "network",
    "filesystem"
  ],
  "autonomous": false,
  "hades_api": ">=0.4.1",
  "source": "https://github.com/Kaliiiiiiiiii-Vinyzu/patchright",
  "license": "Apache-2.0",
  "dependency_install": {
    "timeout_seconds": 1800,
    "stall_timeout_seconds": 900
  },
  "tools": [
    {
      "name": "doctor",
      "action": "doctor",
      "command": [
        "{python}",
        "hades_bridge.py",
        "doctor"
      ],
      "description": "Check whether Patchright is importable in the plugin venv.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "write_files",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network"
        ]
      }
    },
    {
      "name": "install_browsers",
      "action": "install",
      "command": [
        "{python}",
        "hades_bridge.py",
        "install_browsers"
      ],
      "description": "Download Chromium for Patchright (run once after Ready).",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "write_files",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "expensive",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network"
        ]
      }
    },
    {
      "name": "fetch",
      "action": "fetch",
      "command": [
        "{python}",
        "hades_bridge.py",
        "fetch",
        "--url",
        "{url}",
        "--max-chars",
        "{max_chars}"
      ],
      "description": "Open a URL with stealth Chromium and return visible page text.",
      "input_schema": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 8,
            "maxLength": 2000
          },
          "max_chars": {
            "type": "integer",
            "default": 20000,
            "minimum": 500,
            "maximum": 80000
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "write_files",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network"
        ]
      }
    },
    {
      "name": "screenshot",
      "action": "screenshot",
      "command": [
        "{python}",
        "hades_bridge.py",
        "screenshot",
        "--url",
        "{url}",
        "--output",
        "{output}"
      ],
      "description": "Capture a full-page screenshot via Patchright Chromium.",
      "input_schema": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 8,
            "maxLength": 2000
          },
          "output": {
            "type": "string",
            "default": "screenshot.png",
            "maxLength": 400
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "write_files",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network"
        ]
      }
    }
  ],
  "isolation": "restricted_env",
  "capabilities": {
    "effects": [
      "network",
      "read_files",
      "write_files",
      "subprocess"
    ],
    "side_effect_class": "process",
    "cost_class": "moderate",
    "latency_class": "normal",
    "failure_modes": [
      "dependency",
      "schema",
      "timeout",
      "network"
    ]
  },
  "trust_default": "untrusted",
  "marketplace": {
    "pinned_version": "0.1.0",
    "source_url": "https://github.com/Kaliiiiiiiiii-Vinyzu/patchright",
    "signed": false,
    "license": "Apache-2.0"
  }
}
