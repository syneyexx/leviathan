{
  "id": "no-ai-slop",
  "name": "No AI Slop",
  "description": "Remove common AI-writing patterns. HADES can load the skill and run a local cleaner.",
  "runtime_type": "python",
  "entrypoint": "skill_bridge.py",
  "plugin_type": "tool",
  "category": "Developer",
  "labels": [
    "writing",
    "skills",
    "editing"
  ],
  "permissions": [
    "subprocess"
  ],
  "autonomous": true,
  "source": "https://github.com/petergyang/no-ai-slop",
  "tools": [
    {
      "name": "list_skills",
      "action": "list",
      "mode": "command",
      "description": "List skills/rules packaged in No AI Slop.",
      "command": [
        "{python}",
        "skill_bridge.py",
        "list",
        "--limit",
        "{limit}"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 200,
            "minimum": 1,
            "maximum": 1000
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      },
      "metadata": {
        "static_knowledge": true,
        "action": "list"
      }
    },
    {
      "name": "get_skill",
      "action": "get",
      "mode": "command",
      "description": "Load one skill/rule document from No AI Slop.",
      "command": [
        "{python}",
        "skill_bridge.py",
        "get",
        "--skill",
        "{skill}",
        "--max-chars",
        "{max_chars}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "skill"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "max_chars": {
            "type": "integer",
            "default": 16000,
            "minimum": 500,
            "maximum": 80000
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "search_skills",
      "action": "search",
      "mode": "command",
      "description": "Search skills/rules in No AI Slop.",
      "command": [
        "{python}",
        "skill_bridge.py",
        "search",
        "--query",
        "{query}",
        "--limit",
        "{limit}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      },
      "metadata": {
        "static_knowledge": true,
        "action": "search"
      }
    },
    {
      "name": "clean",
      "action": "transform",
      "mode": "command",
      "description": "Strip common AI-slop phrases from text.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "clean",
        "--text",
        "{text}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    }
  ],
  "knowledge_paths": [
    "README.md"
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "hades_api": ">=0.4.1",
  "version": "0.1.0",
  "format": 1,
  "capabilities": {
    "effects": [
      "subprocess"
    ],
    "side_effect_class": "process",
    "cost_class": "cheap",
    "latency_class": "fast",
    "failure_modes": [
      "dependency",
      "schema",
      "timeout"
    ]
  },
  "marketplace": {
    "pinned_version": "0.1.0",
    "source_url": "https://github.com/petergyang/no-ai-slop",
    "signed": false,
    "license": "MIT"
  },
  "license": "MIT"
}
