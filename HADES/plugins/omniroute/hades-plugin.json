{
  "id": "omniroute",
  "name": "OmniRoute",
  "description": "Optional local-first LLM route table: LM Studio by default, extra OpenAI-compatible URLs when configured. Inventory is discovered at runtime.",
  "runtime_type": "python",
  "entrypoint": "hades_bridge.py",
  "plugin_type": "tool",
  "category": "AI",
  "labels": [
    "gateway",
    "lm-studio",
    "routing"
  ],
  "permissions": [
    "subprocess",
    "network"
  ],
  "autonomous": true,
  "source": "https://github.com/diegosouzapw/OmniRoute",
  "tools": [
    {
      "name": "doctor",
      "action": "doctor",
      "mode": "command",
      "description": "Probe local LM Studio and configured extras.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "doctor"
      ],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "network"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network"
        ]
      }
    },
    {
      "name": "list_routes",
      "action": "list",
      "mode": "command",
      "description": "List local and extra OpenAI-compatible routes.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "list_routes"
      ],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "network"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network"
        ]
      }
    },
    {
      "name": "complete",
      "action": "complete",
      "mode": "command",
      "description": "Send a prompt to a chosen local/compatible endpoint. Fails closed if unreachable.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "complete",
        "--prompt",
        "{prompt}",
        "--model",
        "{model}",
        "--base-url",
        "{base_url}",
        "--api-key",
        "{api_key}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "prompt",
          "model"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "base_url": {
            "type": "string",
            "default": "",
            "maxLength": 400
          },
          "api_key": {
            "type": "string",
            "default": "",
            "maxLength": 400
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "network"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network"
        ]
      }
    },
    {
      "name": "chat",
      "action": "chat",
      "mode": "command",
      "description": "OpenAI-compatible chat completion against a discovered route. Auto-selects among available routes when model is omitted. Does not put the catalog in the prompt.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "chat",
        "--payload-file",
        "{payload_file}",
        "--model",
        "{model}",
        "--base-url",
        "{base_url}"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "payload_file": {
            "type": "string",
            "default": "",
            "maxLength": 400
          },
          "model": {
            "type": "string",
            "default": "",
            "maxLength": 200
          },
          "base_url": {
            "type": "string",
            "default": "",
            "maxLength": 400
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "network"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout",
          "network"
        ]
      }
    }
  ],
  "knowledge_paths": [
    "README.md"
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "hades_api": ">=0.4.1",
  "version": "0.2.0",
  "format": 1,
  "capabilities": {
    "effects": [
      "network",
      "subprocess"
    ],
    "side_effect_class": "process",
    "cost_class": "cheap",
    "latency_class": "fast",
    "failure_modes": [
      "dependency",
      "schema",
      "timeout",
      "network"
    ]
  },
  "marketplace": {
    "pinned_version": "0.2.0",
    "source_url": "https://github.com/diegosouzapw/OmniRoute",
    "signed": false,
    "license": "MIT"
  },
  "license": "MIT"
}
