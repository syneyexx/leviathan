{
  "id": "worktrunk",
  "name": "Worktrunk",
  "description": "Git worktree list/add/remove for parallel HADES agent workspaces. Uses git directly (no Rust binary required).",
  "runtime_type": "python",
  "entrypoint": "hades_bridge.py",
  "plugin_type": "tool",
  "category": "Developer",
  "labels": [
    "git",
    "worktrees",
    "agents"
  ],
  "permissions": [
    "subprocess",
    "filesystem"
  ],
  "autonomous": false,
  "source": "https://github.com/max-sixty/worktrunk",
  "tools": [
    {
      "name": "doctor",
      "action": "doctor",
      "mode": "command",
      "description": "Check git availability.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "doctor"
      ],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "list_worktrees",
      "action": "list",
      "mode": "command",
      "description": "List git worktrees for a repo.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "list",
        "--repo",
        "{repo}"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "default": "",
            "maxLength": 400
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "read_files"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "add_worktree",
      "action": "write",
      "mode": "command",
      "description": "Add a git worktree (writes to disk).",
      "command": [
        "{python}",
        "hades_bridge.py",
        "add",
        "--repo",
        "{repo}",
        "--path",
        "{path}",
        "--branch",
        "{branch}",
        "--start-point",
        "{start_point}",
        "--create-branch",
        "{create_branch}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "default": "",
            "maxLength": 400
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "branch": {
            "type": "string",
            "default": "",
            "maxLength": 200
          },
          "start_point": {
            "type": "string",
            "default": "",
            "maxLength": 200
          },
          "create_branch": {
            "type": "string",
            "default": "false",
            "enum": [
              "true",
              "false"
            ]
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "read_files",
          "write_files"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      },
      "autonomous": false
    },
    {
      "name": "remove_worktree",
      "action": "write",
      "mode": "command",
      "description": "Remove a git worktree.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "remove",
        "--repo",
        "{repo}",
        "--path",
        "{path}",
        "--force",
        "{force}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "default": "",
            "maxLength": 400
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "force": {
            "type": "string",
            "default": "false",
            "enum": [
              "true",
              "false"
            ]
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "write_files"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      },
      "autonomous": false
    }
  ],
  "knowledge_paths": [
    "README.md"
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "hades_api": ">=0.4.1",
  "version": "0.1.0",
  "format": 1,
  "capabilities": {
    "effects": [
      "read_files",
      "write_files",
      "subprocess"
    ],
    "side_effect_class": "process",
    "cost_class": "cheap",
    "latency_class": "fast",
    "failure_modes": [
      "dependency",
      "schema",
      "timeout"
    ]
  },
  "marketplace": {
    "pinned_version": "0.1.0",
    "source_url": "https://github.com/max-sixty/worktrunk",
    "signed": false
  }
}
