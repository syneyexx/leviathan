{
  "format": 1,
  "id": "composio",
  "name": "Composio",
  "version": "0.1.0",
  "description": "Composio toolkit discovery for agents. Execution of authenticated remote actions requires COMPOSIO_API_KEY.",
  "runtime_type": "python",
  "entrypoint": "hades_bridge.py",
  "plugin_type": "tool",
  "category": "Tool",
  "labels": [
    "integrations",
    "tools",
    "composio"
  ],
  "permissions": [
    "subprocess",
    "network"
  ],
  "autonomous": true,
  "hades_api": ">=0.4.1",
  "source": "https://github.com/ComposioHQ/composio",
  "tools": [
    {
      "name": "doctor",
      "action": "doctor",
      "command": [
        "{python}",
        "hades_bridge.py",
        "doctor"
      ],
      "description": "Check Composio SDK/CLI and COMPOSIO_API_KEY presence.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "list_toolkits",
      "action": "list",
      "command": [
        "{python}",
        "hades_bridge.py",
        "list_toolkits",
        "--query",
        "{query}",
        "--limit",
        "{limit}"
      ],
      "description": "List/search Composio toolkits/apps available to this install.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "default": ""
          },
          "limit": {
            "type": "integer",
            "default": 30,
            "minimum": 1,
            "maximum": 200
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    }
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "capabilities": {
    "effects": [
      "network",
      "subprocess"
    ],
    "side_effect_class": "process",
    "cost_class": "moderate",
    "latency_class": "normal",
    "failure_modes": [
      "dependency",
      "network",
      "schema",
      "timeout"
    ]
  },
  "marketplace": {
    "pinned_version": "0.1.0",
    "source_url": "https://github.com/ComposioHQ/composio",
    "signed": false
  }
}
