{
  "format": 1,
  "id": "voicestudio",
  "name": "VoiceStudio",
  "version": "0.1.0",
  "description": "Local voice cloning/TTS/ASR studio (AGPL-3.0). HADES can start the published Docker image and healthcheck port 3900.",
  "runtime_type": "python",
  "entrypoint": "start",
  "plugin_type": "service",
  "category": "Tool",
  "labels": [
    "voice",
    "tts",
    "asr",
    "docker"
  ],
  "permissions": [
    "subprocess",
    "network"
  ],
  "autonomous": false,
  "hades_api": ">=0.4.1",
  "source": "https://github.com/debpalash/VoiceStudio",
  "license": "AGPL-3.0",
  "healthcheck": {
    "type": "http",
    "url": "http://127.0.0.1:3900/",
    "method": "GET",
    "expected_status": [
      200,
      301,
      302,
      304
    ],
    "timeout_seconds": 180,
    "interval_seconds": 2.0
  },
  "tools": [
    {
      "name": "doctor",
      "action": "doctor",
      "command": [
        "{python}",
        "hades_bridge.py",
        "doctor"
      ],
      "description": "Check Docker availability and document VoiceStudio OpenAI-compatible audio endpoints.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "service",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "api_probe",
      "action": "command",
      "command": [
        "{python}",
        "hades_bridge.py",
        "api_probe"
      ],
      "description": "Probe GET /v1/audio/voices on the local VoiceStudio OpenAI-compatible API.",
      "input_schema": {
        "type": "object",
        "properties": {
          "base_url": {
            "type": "string",
            "description": "Optional VoiceStudio /v1 base URL."
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network"
        ],
        "side_effect_class": "read",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "network",
          "timeout"
        ]
      }
    },
    {
      "name": "start",
      "action": "start",
      "mode": "service",
      "command": [
        "docker",
        "run",
        "--rm",
        "-p",
        "127.0.0.1:3900:3900",
        "--name",
        "hades-voicestudio",
        "palashdeb/omnivoice-studio:stable"
      ],
      "description": "Start VoiceStudio Docker image on http://127.0.0.1:3900.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "service",
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "moderate",
        "latency_class": "slow",
        "failure_modes": [
          "dependency",
          "healthcheck",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "health",
      "action": "health",
      "mode": "command",
