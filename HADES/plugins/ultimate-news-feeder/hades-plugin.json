      ],
      "description": "Run the full worldwide discovery/crawl/story-intelligence pipeline and upload one provenance-rich knowledge batch to HADES. Requires explicit file-write approval.",
      "input_schema": {
        "type": "object",
        "required": [
          "approved_file_write"
        ],
        "properties": {
          "output_dir": {
            "type": "string",
