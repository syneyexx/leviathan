{
  "format": 1,
  "id": "ultimate-news-feeder",
  "name": "UltimateNewsFeeder",
  "version": "1.2.0",
  "description": "Worldwide news intelligence crawler: direct feeds plus publisher sitemap/homepage discovery, bounded article extraction, cross-source story clustering, provenance, deduplication, and HADES Knowledge ingestion.",
  "runtime_type": "python",
  "entrypoint": "fetch_latest",
  "plugin_type": "tool",
  "category": "Research",
  "labels": [
    "news",
    "rss",
    "crawler",
    "worldwide",
    "knowledge",
    "research",
    "sitemap",
    "discovery",
    "corroboration",
    "story-clustering"
  ],
  "permissions": [
    "subprocess",
    "network",
    "filesystem"
  ],
  "autonomous": false,
  "hades_api": ">=0.4.1",
  "tools": [
    {
      "name": "fetch_latest",
      "action": "download",
      "command": [
        "{python}",
        "ultimate_news_feeder.py",
        "fetch",
        "--output-dir",
        "{output_dir}",
        "--max-sources",
        "{max_sources}",
        "--max-articles",
        "{max_articles}",
        "--per-source",
        "{per_source}",
        "--since-hours",
        "{since_hours}",
        "--timeout-seconds",
        "{timeout_seconds}",
        "--workers",
        "{workers}",
        "--article-workers",
        "{article_workers}",
        "--refresh-sources",
        "{refresh_sources}",
        "--regions",
        "{regions}",
        "--countries",
        "{countries}",
        "--languages",
        "{languages}",
        "--query",
        "{query}",
        "--new-only",
        "{new_only}",
        "--crawl-pages",
        "{crawl_pages}",
        "--max-article-chars",
        "{max_article_chars}",
        "--respect-robots",
        "{respect_robots}",
        "--allow-google-fallback",
        "{allow_google_fallback}",
        "--discover-sites",
        "{discover_sites}",
        "--discovery-sites",
        "{discovery_sites}",
        "--discovery-urls-per-site",
        "{discovery_urls_per_site}",
        "--discovery-workers",
        "{discovery_workers}",
        "--story-clustering",
        "{story_clustering}"
      ],
      "description": "Collect worldwide feed items, discover additional publisher article URLs through sitemaps/homepages, crawl bounded article evidence, deduplicate, cluster stories across publishers, and write JSONL/Markdown.",
      "input_schema": {
        "type": "object",
        "properties": {
          "output_dir": {
            "type": "string",
            "default": "news-output"
          },
          "max_sources": {
            "type": "integer",
            "default": 300,
            "minimum": 1,
            "maximum": 500
          },
          "max_articles": {
            "type": "integer",
            "default": 1000,
            "minimum": 1,
            "maximum": 50000
          },
          "per_source": {
            "type": "integer",
            "default": 8,
            "minimum": 1,
            "maximum": 100
          },
          "since_hours": {
            "type": "number",
            "default": 36,
            "minimum": 0,
            "maximum": 720
          },
          "timeout_seconds": {
            "type": "number",
            "default": 15,
            "minimum": 1,
            "maximum": 120
          },
          "workers": {
            "type": "integer",
            "default": 12,
            "minimum": 1,
            "maximum": 32
          },
          "article_workers": {
            "type": "integer",
            "default": 12,
            "minimum": 1,
            "maximum": 32
          },
          "refresh_sources": {
            "type": "boolean",
            "default": false
          },
          "regions": {
            "type": "string",
            "default": "",
            "description": "Comma-separated macro regions; empty means worldwide."
          },
          "countries": {
            "type": "string",
            "default": "",
            "description": "Comma-separated ISO country codes or country names; empty means all."
          },
          "languages": {
            "type": "string",
            "default": "",
            "description": "Comma-separated language tags; empty means all."
          },
          "query": {
            "type": "string",
            "default": "",
            "description": "Optional case-insensitive filter over feed headline, summary and publisher."
          },
          "new_only": {
            "type": "boolean",
            "default": true
          },
          "crawl_pages": {
            "type": "boolean",
            "default": true,
            "description": "Fetch the publisher article page and extract bounded main-text evidence."
          },
          "max_article_chars": {
            "type": "integer",
            "default": 6000,
            "minimum": 500,
            "maximum": 15000
          },
          "respect_robots": {
            "type": "boolean",
            "default": true
          },
          "allow_google_fallback": {
            "type": "boolean",
            "default": true,
            "description": "Direct publisher feeds are preferred; disable this for direct-only operation."
          },
          "discover_sites": {
            "type": "boolean",
            "default": true,
            "description": "Explore direct publisher robots.txt sitemaps, common sitemap endpoints and relevant homepage links beyond RSS/Atom."
          },
          "discovery_sites": {
            "type": "integer",
            "default": 150,
            "minimum": 1,
            "maximum": 500
          },
          "discovery_urls_per_site": {
            "type": "integer",
            "default": 6,
            "minimum": 1,
            "maximum": 50
          },
          "discovery_workers": {
            "type": "integer",
            "default": 12,
            "minimum": 1,
            "maximum": 32
          },
          "story_clustering": {
            "type": "boolean",
            "default": true,
            "description": "Cluster likely versions of the same story and attach source-diversity/evidence signals. Signals are not truth guarantees."
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "subprocess",
          "write_files"
        ],
        "side_effect_class": "process",
        "cost_class": "expensive",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
          "network",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "feed_hades",
      "action": "write",
      "command": [
        "{python}",
        "ultimate_news_feeder.py",
        "feed-hades",
        "--output-dir",
        "{output_dir}",
        "--max-sources",
        "{max_sources}",
        "--max-articles",
        "{max_articles}",
        "--per-source",
        "{per_source}",
        "--since-hours",
        "{since_hours}",
        "--timeout-seconds",
        "{timeout_seconds}",
        "--workers",
        "{workers}",
        "--article-workers",
        "{article_workers}",
        "--refresh-sources",
        "{refresh_sources}",
        "--regions",
        "{regions}",
        "--countries",
        "{countries}",
        "--languages",
        "{languages}",
        "--query",
        "{query}",
        "--new-only",
        "{new_only}",
        "--crawl-pages",
        "{crawl_pages}",
        "--max-article-chars",
        "{max_article_chars}",
        "--respect-robots",
        "{respect_robots}",
        "--allow-google-fallback",
        "{allow_google_fallback}",
        "--discover-sites",
        "{discover_sites}",
        "--discovery-sites",
        "{discovery_sites}",
        "--discovery-urls-per-site",
        "{discovery_urls_per_site}",
        "--discovery-workers",
