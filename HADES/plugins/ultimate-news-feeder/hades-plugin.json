        "--refresh-sources",
        "{refresh_sources}",
        "--timeout-seconds",
        "{timeout_seconds}",
        "--regions",
        "{regions}",
        "--countries",
        "{countries}",
        "--languages",
        "{languages}",
        "--allow-google-fallback",
        "{allow_google_fallback}",
        "--show",
        "{show}"
      ],
      "description": "Inspect or refresh the source catalog and show distribution by country, region and source kind.",
      "input_schema": {
        "type": "object",
        "properties": {
          "max_sources": {
