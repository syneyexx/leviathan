            "default": 300,
            "minimum": 1,
            "maximum": 500
          },
          "max_articles": {
            "type": "integer",
            "default": 1000,
            "minimum": 1,
            "maximum": 50000
          },
          "per_source": {
            "type": "integer",
            "default": 8,
            "minimum": 1,
            "maximum": 100
          },
          "since_hours": {
            "type": "number",
            "default": 36,
            "minimum": 0,
            "maximum": 720
          },
          "timeout_seconds": {
            "type": "number",
            "default": 15,
            "minimum": 1,
            "maximum": 120
          },
          "workers": {
            "type": "integer",
            "default": 12,
            "minimum": 1,
            "maximum": 32
          },
          "article_workers": {
            "type": "integer",
            "default": 12,
            "minimum": 1,
            "maximum": 32
          },
          "refresh_sources": {
            "type": "boolean",
            "default": false
          },
          "regions": {
            "type": "string",
            "default": ""
          },
          "countries": {
            "type": "string",
            "default": ""
          },
          "languages": {
            "type": "string",
            "default": ""
          },
          "query": {
            "type": "string",
            "default": ""
          },
          "new_only": {
            "type": "boolean",
            "default": true
          },
          "crawl_pages": {
            "type": "boolean",
            "default": true
          },
          "max_article_chars": {
            "type": "integer",
            "default": 6000,
            "minimum": 500,
            "maximum": 15000
          },
          "respect_robots": {
            "type": "boolean",
            "default": true
          },
          "allow_google_fallback": {
            "type": "boolean",
            "default": true
          },
          "hades_api_url": {
            "type": "string",
            "default": "http://127.0.0.1:8000/api"
          },
          "approved_file_write": {
            "type": "boolean",
            "description": "Explicitly approve local output and HADES Knowledge ingest."
          },
          "discover_sites": {
            "type": "boolean",
            "default": true,
            "description": "Explore direct publisher robots.txt sitemaps, common sitemap endpoints and relevant homepage links beyond RSS/Atom."
          },
          "discovery_sites": {
            "type": "integer",
            "default": 150,
            "minimum": 1,
            "maximum": 500
          },
          "discovery_urls_per_site": {
            "type": "integer",
            "default": 6,
            "minimum": 1,
            "maximum": 50
          },
          "discovery_workers": {
            "type": "integer",
            "default": 12,
            "minimum": 1,
            "maximum": 32
          },
          "story_clustering": {
            "type": "boolean",
            "default": true,
            "description": "Cluster likely versions of the same story and attach source-diversity/evidence signals. Signals are not truth guarantees."
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "network",
          "read_files",
          "subprocess",
          "write_files"
        ],
        "side_effect_class": "process",
        "cost_class": "expensive",
        "latency_class": "normal",
        "failure_modes": [
          "dependency",
