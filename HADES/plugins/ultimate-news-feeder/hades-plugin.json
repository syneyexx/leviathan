        ]
      }
    },
    {
      "name": "discover_websites",
      "action": "inspect",
      "command": [
        "{python}",
        "ultimate_news_feeder.py",
        "discover-sites",
        "--max-sources",
        "{max_sources}",
        "--refresh-sources",
        "{refresh_sources}",
        "--timeout-seconds",
        "{timeout_seconds}",
        "--discovery-sites",
        "{discovery_sites}",
        "--discovery-urls-per-site",
        "{discovery_urls_per_site}",
        "--discovery-workers",
        "{discovery_workers}",
        "--respect-robots",
        "{respect_robots}",
        "--show-sites",
        "{show_sites}"
      ],
      "description": "Inspect the publisher discovery layer: robots.txt sitemaps, sitemap indexes/news sitemaps and article-like homepage links for direct sources.",
      "input_schema": {
