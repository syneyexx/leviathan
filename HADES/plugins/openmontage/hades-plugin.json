{
  "id": "openmontage",
  "name": "OpenMontage",
  "description": "Agentic video-production skills plus local ffmpeg probe/cut tools for HADES.",
  "runtime_type": "python",
  "entrypoint": "skill_bridge.py",
  "plugin_type": "tool",
  "category": "Media",
  "labels": [
    "video",
    "ffmpeg",
    "skills"
  ],
  "permissions": [
    "subprocess"
  ],
  "autonomous": true,
  "source": "https://github.com/calesthio/OpenMontage",
  "tools": [
    {
      "name": "list_entries",
      "action": "list",
      "mode": "command",
      "description": "List packaged files in OpenMontage.",
      "command": [
        "{python}",
        "catalog_bridge.py",
        "list",
        "--limit",
        "{limit}"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 100,
            "minimum": 1,
            "maximum": 500
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      },
      "metadata": {
        "static_knowledge": true,
        "action": "list"
      }
    },
    {
      "name": "search",
      "action": "search",
      "mode": "command",
      "description": "Search OpenMontage for a query string.",
      "command": [
        "{python}",
        "catalog_bridge.py",
        "search",
        "--query",
        "{query}",
        "--limit",
        "{limit}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      },
      "metadata": {
        "static_knowledge": true,
        "action": "search"
      }
    },
    {
      "name": "read",
      "action": "read",
      "mode": "command",
      "description": "Read one file from OpenMontage.",
      "command": [
        "{python}",
        "catalog_bridge.py",
        "read",
        "--path",
        "{path}",
        "--max-chars",
        "{max_chars}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "max_chars": {
            "type": "integer",
            "default": 12000,
            "minimum": 500,
            "maximum": 50000
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "list_skills",
      "action": "list",
      "mode": "command",
      "description": "List skills/rules packaged in OpenMontage.",
      "command": [
        "{python}",
        "skill_bridge.py",
        "list",
        "--limit",
        "{limit}"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 200,
            "minimum": 1,
            "maximum": 1000
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      },
      "metadata": {
        "static_knowledge": true,
        "action": "list"
      }
    },
    {
      "name": "get_skill",
      "action": "get",
      "mode": "command",
      "description": "Load one skill/rule document from OpenMontage.",
      "command": [
        "{python}",
        "skill_bridge.py",
        "get",
        "--skill",
        "{skill}",
        "--max-chars",
        "{max_chars}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "skill"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "max_chars": {
            "type": "integer",
            "default": 16000,
            "minimum": 500,
            "maximum": 80000
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "search_skills",
      "action": "search",
      "mode": "command",
      "description": "Search skills/rules in OpenMontage.",
      "command": [
        "{python}",
        "skill_bridge.py",
        "search",
        "--query",
        "{query}",
        "--limit",
        "{limit}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      },
      "metadata": {
        "static_knowledge": true,
        "action": "search"
      }
    },
    {
      "name": "doctor",
      "action": "doctor",
      "mode": "command",
      "description": "Check ffmpeg/ffprobe.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "doctor"
      ],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "probe",
      "action": "probe",
      "mode": "command",
      "description": "Probe a local video with ffprobe.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "probe",
        "--path",
        "{path}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "read_files"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "cut",
      "action": "cut",
      "mode": "command",
      "description": "Cut a local clip with ffmpeg stream copy.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "cut",
        "--path",
        "{path}",
        "--start",
        "{start}",
        "--duration",
        "{duration}",
        "--output",
        "{output}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "start": {
            "type": "string",
            "default": "0",
            "maxLength": 32
          },
          "duration": {
            "type": "string",
            "default": "10",
            "maxLength": 32
          },
          "output": {
            "type": "string",
            "default": "clip.mp4",
            "maxLength": 300
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "read_files",
          "write_files"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      },
      "autonomous": false
    }
  ],
  "knowledge_paths": [
    "README.md"
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "hades_api": ">=0.4.1",
  "version": "0.1.0",
  "format": 1,
  "capabilities": {
    "effects": [
