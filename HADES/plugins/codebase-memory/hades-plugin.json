{
  "id": "codebase-memory",
  "name": "Codebase Memory",
  "description": "Local symbol/FTS index of a workspace so HADES can query a codebase without the upstream C MCP binary.",
  "runtime_type": "python",
  "entrypoint": "hades_bridge.py",
  "plugin_type": "tool",
  "category": "Developer",
  "labels": [
    "code-intelligence",
    "index",
    "memory"
  ],
  "permissions": [
    "subprocess",
    "filesystem"
  ],
  "autonomous": true,
  "source": "https://github.com/DeusData/codebase-memory-mcp",
  "tools": [
    {
      "name": "doctor",
      "action": "doctor",
      "mode": "command",
      "description": "Report local indexer status.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "doctor"
      ],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "index",
      "action": "index",
      "mode": "command",
      "description": "Index a local source tree into SQLite FTS.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "index",
        "--root",
        "{root}",
        "--db",
        "{db}",
        "--limit",
        "{limit}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "db": {
            "type": "string",
            "default": "codebase-memory.sqlite",
            "maxLength": 300
          },
          "limit": {
            "type": "integer",
            "default": 4000,
            "minimum": 10,
            "maximum": 20000
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "read_files",
          "write_files"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      },
      "autonomous": false
    },
    {
      "name": "query",
      "action": "search",
      "mode": "command",
      "description": "Search the local codebase memory index.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "query",
        "--query",
        "{query}",
        "--db",
        "{db}",
        "--limit",
        "{limit}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "db": {
            "type": "string",
            "default": "codebase-memory.sqlite",
            "maxLength": 300
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "read_files"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    },
    {
      "name": "outline",
      "action": "list",
      "mode": "command",
      "description": "List indexable source files under a root.",
      "command": [
        "{python}",
        "hades_bridge.py",
        "outline",
        "--root",
        "{root}",
        "--limit",
        "{limit}"
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "limit": {
            "type": "integer",
            "default": 200,
            "minimum": 1,
            "maximum": 2000
          }
        },
        "additionalProperties": false
      },
      "capabilities": {
        "effects": [
          "subprocess",
          "read_files"
        ],
        "side_effect_class": "process",
        "cost_class": "cheap",
        "latency_class": "fast",
        "failure_modes": [
          "dependency",
          "schema",
          "timeout"
        ]
      }
    }
  ],
  "knowledge_paths": [
    "README.md"
  ],
  "isolation": "plugin_cwd",
  "trust_default": "untrusted",
  "hades_api": ">=0.4.1",
  "version": "0.1.0",
  "format": 1,
  "capabilities": {
    "effects": [
      "read_files",
      "write_files",
      "subprocess"
    ],
    "side_effect_class": "process",
    "cost_class": "cheap",
    "latency_class": "fast",
    "failure_modes": [
      "dependency",
      "schema",
      "timeout"
    ]
  },
  "marketplace": {
    "pinned_version": "0.1.0",
    "source_url": "https://github.com/DeusData/codebase-memory-mcp",
    "signed": false,
    "license": "MIT"
  },
  "license": "MIT"
}
