# HADES — Cursor context exclusions
# Purpose: keep Cursor focused on current authored source + current architecture/context.
# This file only affects Cursor indexing/context; it does not change HADES runtime access.

# Secrets / local configuration
.env
.env.*
backend/.env
**/credentials.json
**/secrets.json
**/*.pem
**/*.key
**/id_rsa*

# Dependency trees / virtual environments
node_modules/
backend/.venv/
**/.venv/
**/venv/

# HADES local build/cache output
.hades-cache/
dist/
build/
out/
coverage/
htmlcov/
test-results/
playwright-report/
.next/
.wrangler/
.sites-runtime/
native/build/
native/build-*/
native/**/build/
native/**/build-*/

# Python / JS caches
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.eslintcache
.nyc_output/

# HADES runtime state — large and not authored source
backend/data/
outputs/
work/
tmp/
temp/

# Installed/upstream plugin payloads
plugins/**/node_modules/
plugins/**/.venv/
plugins/**/runtime/
plugins/**/upstream/
plugins/**/source/

# Historical material: available in Git, excluded from normal Cursor context
# Current source of truth lives in docs/ + docs/CURSOR_PAGE_INVENTORY.md.
docs/archive/
artifacts/audit/

# Logs, databases and generated/package artifacts
**/*.log
**/*.db
**/*.db-shm
**/*.db-wal
**/*.db-journal
**/*.sqlite
**/*.sqlite3
**/*.zip
**/*.7z
**/*.tar
**/*.gz
**/*.HadesPlugin
**/*.exe
**/*.dll
**/*.pdb
**/*.lib
**/*.exp
**/*.tmp

# Local model / dataset payloads — never useful for normal source edits
**/*.gguf
**/*.safetensors
**/*.onnx
**/*.ckpt
**/*.pt
**/*.pth
**/*.parquet
**/*.arrow
**/*.npy
**/*.npz

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*.log

# Deliberately keep authored source, tests, active docs, package manifests,
# .cursor/rules/, AGENTS.md and the active TODO/security list visible.
