{
  "module_id": "ghosttrack",
  "name": "GhostTrack",
  "version": "0.1.0",
  "entrypoint": "Data.modules.module_manager.external.module:create_external_capability_module",
  "side_effects": [
    "READ",
    "NETWORK"
  ],
  "hot_reload": false,
  "external": {
    "adapter": "CLI",
    "source_type": "git",
    "source": "https://github.com/HunxByts/GhostTrack",
    "ref": "main",
    "install": {
      "strategy": [
        "GIT_CHECKOUT",
        "PYTHON_VENV"
      ],
      "requirements_file": "requirements.txt",
      "dependencies": [
        "python3"
      ]
    },
    "runtime": {
      "mode": "EPHEMERAL",
      "cwd": "$INSTALL_ROOT",
      "timeout_seconds": 30,
      "operations": []
    },
    "result": {
      "format": "TEXT"
    },
    "assimilation_mode": "EVIDENCE",
    "tags": [
      "osint",
      "tracking"
    ],
    "domain": "osint",
    "resource_class": "NETWORK_HEAVY",
    "metadata": {
      "invoke_blocked": "BLOCKED_EXTERNAL",
      "reason": "GhostTR.py is interactive-only (input() menu); no argv/subcommand machine contract. Install/discover only until upstream adds non-interactive CLI."
    }
  },
  "capabilities": [
    {
      "capability_id": "external.ghosttrack.status",
      "name": "GhostTrack Install Status",
      "description": "Report GhostTrack installation readiness. Invoke of GhostTR.py is BLOCKED_EXTERNAL (interactive TUI only).",
      "external_name": "status",
      "side_effects": [
        "READ"
      ]
    }
  ]
}
