{
  "module_id": "agent-reach",
  "name": "Agent Reach",
  "version": "0.2.0",
  "entrypoint": "Data.modules.module_manager.external.module:create_external_capability_module",
  "side_effects": [
    "READ",
    "NETWORK"
  ],
  "hot_reload": false,
  "external": {
    "adapter": "COMPOSITE",
    "source_type": "git",
    "source": "https://github.com/Panniantong/Agent-Reach",
    "ref": "main",
    "children": [
      "SKILL_PACK",
      "CLI"
    ],
    "install": {
      "strategy": [
        "GIT_CHECKOUT",
        "PYTHON_VENV"
      ],
      "requirements_file": "requirements.txt"
    },
    "skill_roots": [
      ".",
      "skills",
      "docs"
    ],
    "runtime": {
      "mode": "EPHEMERAL",
      "command": [
        "agent-reach",
        "doctor"
      ],
      "cwd": "$INSTALL_ROOT",
      "timeout_seconds": 600,
      "operations": [
        {
          "name": "doctor",
          "command": [
            "agent-reach",
            "doctor"
          ]
        },
        {
          "name": "search",
          "command": [
            "agent-reach",
            "search",
            "{query}"
          ]
        },
        {
          "name": "run",
          "command": [
            "agent-reach",
            "{query}"
          ]
        }
      ]
    },
    "result": {
      "format": "MIXED",
      "parse_stdout_json": true
    },
    "assimilation_mode": "KNOWLEDGE_CANDIDATE",
    "tags": [
      "osint",
      "research",
      "reddit",
      "youtube",
      "github",
      "skill"
    ],
    "domain": "osint",
    "resource_class": "NETWORK_HEAVY",
    "metadata": {
      "preferred_machine_contract": "CLI + SKILL.md capability layer; MCP channel backends optional via mcporter",
      "not_a_second_agent_runtime": true
    }
  },
  "capabilities": [
    {
      "capability_id": "external.agent_reach.doctor",
      "name": "Agent-Reach Doctor",
      "description": "Diagnose Agent-Reach channel backends (YouTube, GitHub, RSS, etc.).",
      "external_name": "doctor",
      "side_effects": [
        "READ",
        "NETWORK"
      ]
    },
    {
      "capability_id": "external.agent_reach.search",
      "name": "Agent-Reach Search",
      "description": "Search/read internet sources via Agent-Reach CLI routing (not a parallel agent runtime).",
      "external_name": "search",
      "side_effects": [
        "READ",
        "NETWORK"
      ]
    },
    {
      "capability_id": "external.agent_reach.load_skill",
      "name": "Agent-Reach Load Skill",
      "description": "Load Agent-Reach SKILL.md instructions on demand.",
      "external_name": "load",
      "side_effects": [
        "READ"
      ]
    }
  ]
}
