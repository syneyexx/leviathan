{
  "module_id": "agent-reach",
  "name": "Agent Reach",
  "version": "0.3.0",
  "entrypoint": "Data.modules.module_manager.external.module:create_external_capability_module",
  "side_effects": [
    "READ",
    "NETWORK"
  ],
  "hot_reload": false,
  "external": {
    "adapter": "COMPOSITE",
    "source_type": "git",
    "source": "https://github.com/Panniantong/Agent-Reach",
    "ref": "main",
    "children": [
      "SKILL_PACK",
      "CLI"
    ],
    "install": {
      "strategy": [
        "GIT_CHECKOUT",
        "PYTHON_VENV"
      ],
      "python_packages": [
        "yt-dlp[default]"
      ],
      "dependencies": [
        "python3",
        "curl"
      ]
    },
    "skill_roots": [
      "agent_reach/skill",
      "skills",
      "."
    ],
    "runtime": {
      "mode": "EPHEMERAL",
      "cwd": "$INSTALL_ROOT",
      "timeout_seconds": 120,
      "operations": [
        {
          "name": "doctor",
          "command": [
            "agent-reach",
            "doctor",
            "--json"
          ]
        },
        {
          "name": "watch",
          "command": [
            "agent-reach",
            "watch"
          ]
        },
        {
          "name": "check_update",
          "command": [
            "agent-reach",
            "check-update"
          ]
        },
        {
          "name": "version",
          "command": [
            "agent-reach",
            "version"
          ]
        },
        {
          "name": "fetch_url",
          "command": [
            "curl",
            "-sS",
            "https://r.jina.ai/{url}"
          ],
          "timeout_seconds": 60
        },
        {
          "name": "v2ex_hot",
          "command": [
            "curl",
            "-sS",
            "https://www.v2ex.com/api/topics/hot.json",
            "-H",
            "User-Agent: agent-reach/1.0"
          ],
          "timeout_seconds": 45
        }
      ]
    },
    "result": {
      "format": "MIXED",
      "parse_stdout_json": true
    },
    "assimilation_mode": "KNOWLEDGE_CANDIDATE",
    "tags": [
      "osint",
      "research",
      "reddit",
      "youtube",
      "github",
      "skill",
      "router"
    ],
    "domain": "osint",
    "resource_class": "NETWORK_HEAVY",
    "metadata": {
      "preferred_machine_contract": "SKILL.md internet router + CLI doctor/watch + zero-config fetch_url (Jina) / v2ex_hot. No native `agent-reach search` subcommand — other platforms via upstream tools (gh, yt-dlp, mcporter, bili). Upstream MCP get_status incompatible with modern mcp SDK — CLI doctor --json is status contract.",
      "not_a_second_agent_runtime": true,
      "no_native_search_subcommand": true
    }
  },
  "capabilities": [
    {
      "capability_id": "external.agent_reach.doctor",
      "name": "Agent-Reach Doctor",
      "description": "JSON channel availability report (which backends are installed/active).",
      "external_name": "doctor",
      "side_effects": [
        "READ",
        "NETWORK"
      ]
    },
    {
      "capability_id": "external.agent_reach.watch",
      "name": "Agent-Reach Watch",
      "description": "Quick health + update check for scheduled monitoring.",
      "external_name": "watch",
      "side_effects": [
        "READ",
        "NETWORK"
      ]
    },
    {
      "capability_id": "external.agent_reach.check_update",
      "name": "Agent-Reach Check Update",
      "description": "Check whether a newer Agent-Reach package/version is available (CLI check-update).",
      "external_name": "check_update",
      "side_effects": [
        "READ",
        "NETWORK"
      ]
    },
    {
      "capability_id": "external.agent_reach.version",
      "name": "Agent-Reach Version",
      "description": "Report installed Agent-Reach CLI version.",
      "external_name": "version",
      "side_effects": [
        "READ"
      ]
    },
    {
      "capability_id": "external.agent_reach.fetch_url",
      "name": "Agent-Reach Fetch URL (Jina)",
      "description": "Read an arbitrary URL via Jina Reader (skill-routed zero-config web path).",
      "external_name": "fetch_url",
      "side_effects": [
        "READ",
        "NETWORK"
      ]
    },
    {
      "capability_id": "external.agent_reach.v2ex_hot",
      "name": "Agent-Reach V2EX Hot",
      "description": "Fetch V2EX hot topics JSON (skill-routed zero-config social path).",
      "external_name": "v2ex_hot",
      "side_effects": [
        "READ",
        "NETWORK"
      ]
    },
    {
      "capability_id": "external.agent_reach.load_skill",
      "name": "Agent-Reach Load Skill",
      "description": "Load Agent-Reach SKILL.md internet-routing instructions on demand (not prompt-injected).",
      "external_name": "load",
      "side_effects": [
        "READ"
      ]
    },
    {
      "capability_id": "external.agent_reach.search_skills",
      "name": "Agent-Reach Search Skills",
      "description": "Search indexed Agent-Reach skill metadata (not a platform scrape).",
      "external_name": "search_skills",
      "side_effects": [
        "READ"
      ]
    }
  ]
}
