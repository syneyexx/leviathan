{
  "module_id": "agent-reach",
  "name": "Agent Reach",
  "version": "0.3.0",
  "entrypoint": "Data.modules.module_manager.external.module:create_external_capability_module",
  "side_effects": [
    "READ",
    "NETWORK"
  ],
  "hot_reload": false,
  "external": {
    "adapter": "COMPOSITE",
    "source_type": "git",
    "source": "https://github.com/Panniantong/Agent-Reach",
    "ref": "main",
    "children": [
      "SKILL_PACK",
      "CLI"
    ],
    "install": {
      "strategy": [
        "GIT_CHECKOUT",
        "PYTHON_VENV"
      ],
      "dependencies": [
        "python3"
      ]
    },
    "skill_roots": [
      "agent_reach/skill",
      "skills",
      "."
    ],
    "runtime": {
      "mode": "EPHEMERAL",
      "cwd": "$INSTALL_ROOT",
      "timeout_seconds": 120,
      "operations": [
        {
          "name": "doctor",
          "command": [
            "agent-reach",
            "doctor",
            "--json"
          ]
        },
        {
          "name": "watch",
          "command": [
            "agent-reach",
            "watch"
          ]
        },
        {
          "name": "check_update",
          "command": [
            "agent-reach",
            "check-update"
          ]
        },
        {
          "name": "version",
          "command": [
            "agent-reach",
            "version"
          ]
        }
      ]
    },
    "result": {
      "format": "MIXED",
      "parse_stdout_json": true
    },
    "assimilation_mode": "KNOWLEDGE_CANDIDATE",
    "tags": [
      "osint",
      "research",
      "reddit",
      "youtube",
      "github",
      "skill",
      "router"
    ],
    "domain": "osint",
    "resource_class": "NETWORK_HEAVY",
    "metadata": {
      "preferred_machine_contract": "SKILL.md internet router + CLI doctor/watch/check-update/version. No native `agent-reach search` subcommand — platform reads are routed by the skill to upstream tools (gh, yt-dlp, jina, mcporter, bili). Upstream MCP get_status server is currently incompatible with modern mcp SDK (list_tools API) so CLI doctor --json is the status contract.",
      "not_a_second_agent_runtime": true,
      "no_native_search_subcommand": true
    }
  },
  "capabilities": [
    {
      "capability_id": "external.agent_reach.doctor",
      "name": "Agent-Reach Doctor",
      "description": "JSON channel availability report (which backends are installed/active).",
      "external_name": "doctor",
      "side_effects": [
        "READ",
        "NETWORK"
      ]
    },
    {
      "capability_id": "external.agent_reach.watch",
      "name": "Agent-Reach Watch",
      "description": "Quick health + update check for scheduled monitoring.",
      "external_name": "watch",
      "side_effects": [
        "READ",
        "NETWORK"
      ]
    },
    {
      "capability_id": "external.agent_reach.load_skill",
      "name": "Agent-Reach Load Skill",
      "description": "Load Agent-Reach SKILL.md internet-routing instructions on demand (not prompt-injected).",
      "external_name": "load",
      "side_effects": [
        "READ"
      ]
    },
    {
      "capability_id": "external.agent_reach.search_skills",
      "name": "Agent-Reach Search Skills",
      "description": "Search indexed Agent-Reach skill metadata (not a platform scrape).",
      "external_name": "search_skills",
      "side_effects": [
        "READ"
      ]
    }
  ]
}
