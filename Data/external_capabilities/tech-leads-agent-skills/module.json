{
  "module_id": "tech-leads-agent-skills",
  "name": "Tech Leads Club Agent Skills",
  "version": "0.2.0",
  "entrypoint": "Data.modules.module_manager.external.module:create_external_capability_module",
  "side_effects": [
    "READ",
    "NETWORK"
  ],
  "hot_reload": false,
  "external": {
    "adapter": "SKILL_PACK",
    "source_type": "git",
    "source": "https://github.com/tech-leads-club/agent-skills",
    "ref": "main",
    "install": {
      "strategy": "GIT_CHECKOUT"
    },
    "runtime": {
      "mode": "NONE"
    },
    "skill_roots": [
      "packages/skills-catalog/skills"
    ],
    "assimilation_mode": "NONE",
    "tags": [
      "skill"
    ],
    "domain": "skills",
    "metadata": {
      "preferred_machine_contract": "packages/skills-catalog/skills/**/SKILL.md"
    }
  },
  "capabilities": [
    {
      "capability_id": "external.tech_leads_agent_skills.search",
      "name": "Search Tech Leads Club Agent Skills",
      "description": "Search skills from Tech Leads Club Agent Skills.",
      "external_name": "search",
      "side_effects": [
        "READ"
      ]
    },
    {
      "capability_id": "external.tech_leads_agent_skills.load",
      "name": "Load Tech Leads Club Agent Skills Skill",
      "description": "On-demand load a skill from Tech Leads Club Agent Skills.",
      "external_name": "load",
      "side_effects": [
        "READ"
      ]
    }
  ]
}
