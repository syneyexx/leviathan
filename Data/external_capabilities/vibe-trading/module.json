{
  "module_id": "vibe-trading",
  "name": "Vibe Trading (research)",
  "version": "0.1.0",
  "entrypoint": "Data.modules.module_manager.external.module:create_external_capability_module",
  "side_effects": [
    "READ",
    "NETWORK"
  ],
  "hot_reload": false,
  "external": {
    "adapter": "MCP",
    "source_type": "git",
    "source": "https://github.com/HKUDS/Vibe-Trading",
    "ref": "main",
    "install": {
      "strategy": [
        "GIT_CHECKOUT",
        "PYTHON_VENV"
      ],
      "dependencies": [
        "python3"
      ]
    },
    "runtime": {
      "mode": "LAZY",
      "mcp_server_id": "vibe-trading",
      "eager_start": false
    },
    "assimilation_mode": "EVIDENCE",
    "resource_class": "NETWORK_HEAVY",
    "tags": [
      "finance",
      "research",
      "trading-analytics"
    ],
    "domain": "finance",
    "metadata": {
      "marketsim_bypass_forbidden": true,
      "real_money_blocked": true,
      "preferred_machine_contract": "MCP + FastAPI research surface (pip: vibe-trading-ai); not MarketSim authority",
      "not_a_second_trading_platform": true
    }
  },
  "capabilities": [
    {
      "capability_id": "external.vibe_trading.ensure_ready",
      "name": "Vibe-Trading Ensure Ready",
      "description": "Lazy-start Vibe-Trading MCP session and refresh tools into CapabilityCatalog. Individual MCP tools invoke via ExecutionGateway/McpBridge — not MarketSim authority.",
      "external_name": "start",
      "side_effects": [
        "READ",
        "NETWORK"
      ]
    },
    {
      "capability_id": "external.vibe_trading.status",
      "name": "Vibe-Trading Status",
      "description": "Health/status of the Vibe-Trading MCP session (research only; real-money blocked).",
      "external_name": "status",
      "side_effects": [
        "READ"
      ]
    }
  ],
  "mcp": {
    "servers": [
      {
        "server_id": "vibe-trading",
        "display_name": "Vibe Trading",
        "transport": "stdio",
        "command": "python",
        "args": [
          "-m",
          "vibe_trading"
        ],
        "cwd": "$INSTALL_ROOT",
        "enabled": false,
        "eager_connect": false,
        "trust": "untrusted"
      }
    ]
  }
}
