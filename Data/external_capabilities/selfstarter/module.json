{
  "module_id": "selfstarter",
  "name": "Selfstarter",
  "version": "0.1.0",
  "entrypoint": "Data.modules.module_manager.external.module:create_external_capability_module",
  "side_effects": [
    "READ",
    "EXECUTE"
  ],
  "hot_reload": false,
  "external": {
    "adapter": "COMPOSITE",
    "children": [
      "SCRIPT_PACKAGE",
      "CLI"
    ],
    "source_type": "git",
    "source": "https://github.com/ukanwat/selfstarter",
    "ref": "main",
    "install": {
      "strategy": [
        "GIT_CHECKOUT"
      ],
      "dependencies": [
        "bash"
      ]
    },
    "runtime": {
      "mode": "EPHEMERAL",
      "timeout_seconds": 3600,
      "cwd": "$INSTALL_ROOT",
      "operations": [
        {
          "name": "run_brief",
          "command": [
            "bash",
            "bin/run-agent.sh"
          ]
        },
        {
          "name": "status",
          "command": [
            "bash",
            "bin/health.sh"
          ]
        },
        {
          "name": "supervise",
          "command": [
            "bash",
            "bin/supervise.sh"
          ]
        },
        {
          "name": "setup",
          "command": [
            "bash",
            "bin/setup-capabilities.sh"
          ]
        },
        {
          "name": "cancel",
          "command": [
            "bash",
            "-c",
            "test -f /tmp/aaabench-agent.lock && kill \"$(cat /tmp/aaabench-agent.lock)\" || true"
          ]
        }
      ]
    },
    "result": {
      "format": "MIXED",
      "artifact_globs": [
        "project/**",
        "docs/**",
        "artifacts/**",
        "output/**"
      ]
    },
    "assimilation_mode": "NONE",
    "tags": [
      "autonomous",
      "long-horizon",
      "coding",
      "unreal"
    ],
    "domain": "specialist",
    "resource_class": "CPU_HEAVY",
    "metadata": {
      "does_not_replace_cognitive_runtime": true,
      "preferred_machine_contract": "Shell harness under bin/ (run-agent/health/supervise); Unreal MCP bridge",
      "blocked_external_requirements": [
        "Unreal Engine 5.8",
        "Unreal MCP plugin",
        "Claude Code / coding agent CLI"
      ],
      "not_a_python_module": true
    }
  },
  "capabilities": [
    {
      "capability_id": "external.selfstarter.run_brief",
      "name": "Selfstarter Run Brief",
      "description": "Run Selfstarter bin/run-agent.sh as an external specialist job (requires UE5 + MCP; otherwise DEPENDENCY_MISSING).",
      "external_name": "run_brief",
      "side_effects": [
        "EXECUTE",
        "WRITE"
      ]
    },
    {
      "capability_id": "external.selfstarter.status",
      "name": "Selfstarter Status",
      "description": "Check Selfstarter harness health via bin/health.sh.",
      "external_name": "status",
      "side_effects": [
        "READ"
      ]
    },
    {
      "capability_id": "external.selfstarter.cancel",
      "name": "Selfstarter Cancel",
      "description": "Cancel the Selfstarter agent lock/session when supported.",
      "external_name": "cancel",
      "side_effects": [
        "EXECUTE"
      ]
    },
    {
      "capability_id": "external.selfstarter.results",
      "name": "Selfstarter Results",
      "description": "Collect Selfstarter project/docs artifacts after a run.",
      "external_name": "supervise",
      "side_effects": [
        "READ"
      ]
    }
  ]
}
