{
  "module_id": "openmaic",
  "name": "OpenMAIC",
  "version": "1.1.1",
  "entrypoint": "Data.modules.module_manager.external.module:create_external_capability_module",
  "side_effects": [
    "READ",
    "NETWORK"
  ],
  "hot_reload": false,
  "external": {
    "adapter": "COMPOSITE",
    "children": [
      "SKILL_PACK",
      "PROCESS_SERVICE"
    ],
    "source_type": "git",
    "source": "https://github.com/THU-MAIC/OpenMAIC",
    "ref": "main",
    "install": {
      "strategy": [
        "GIT_CHECKOUT",
        "NODE_PNPM"
      ],
      "dependencies": [
        "node",
        "pnpm"
      ]
    },
    "runtime": {
      "mode": "LAZY",
      "command": [
        "pnpm",
        "dev",
        "--",
        "-p",
        "3000",
        "-H",
        "127.0.0.1"
      ],
      "cwd": "$INSTALL_ROOT",
      "startup_timeout_seconds": 180,
      "idle_timeout_seconds": 1800,
      "base_url": "http://127.0.0.1:3000",
      "ready_probe": {
        "kind": "http",
        "url": "http://127.0.0.1:3000",
        "expect_status": 200
      },
      "health_probe": {
        "kind": "http",
        "url": "http://127.0.0.1:3000",
        "expect_status": 200
      },
      "operations": [
        {
          "name": "generate_course",
          "method": "POST",
          "path": "/api/agent/sessions",
          "body_from": [
            "topic",
            "level",
            "prompt",
            "message"
          ]
        },
        {
          "name": "session_status",
          "method": "GET",
          "path": "/api/agent/sessions/status"
        },
        {
          "name": "cancel_session",
          "method": "POST",
          "path": "/api/agent/sessions/{session_id}/cancel",
          "path_params": [
            "session_id"
          ]
        },
        {
          "name": "list_skills",
          "method": "GET",
          "path": "/api/agent/skills"
        }
      ],
      "eager_start": false
    },
    "result": {
      "format": "MIXED",
      "artifact_globs": [
        "output/**",
        "courses/**",
        "*.pptx",
        "*.html"
      ]
    },
    "skill_roots": [
      "skills",
      "packages/@openmaic/importer"
    ],
    "assimilation_mode": "NONE",
    "tags": [
      "education",
      "course",
      "skill"
    ],
    "domain": "education",
    "resource_class": "CPU_HEAVY",
    "metadata": {
      "preferred_machine_contract": "Next.js PROCESS_SERVICE on :3000 + SKILL.md packs under skills/",
      "requires_node": ">=22.19.0",
      "llm_provider_keys_required": true
    }
  },
  "capabilities": [
    {
      "capability_id": "external.openmaic.generate_course",
      "name": "OpenMAIC Generate Course",
      "description": "Create an OpenMAIC agent session to generate course/slides/quizzes for a topic.",
      "external_name": "generate_course",
      "side_effects": [
        "EXECUTE",
        "WRITE",
        "NETWORK"
      ]
    },
    {
      "capability_id": "external.openmaic.start",
      "name": "Start OpenMAIC",
      "description": "Start OpenMAIC local Next.js runtime if needed.",
      "external_name": "start",
      "side_effects": [
        "EXECUTE"
      ]
    },
    {
      "capability_id": "external.openmaic.stop",
      "name": "Stop OpenMAIC",
      "description": "Stop OpenMAIC local runtime.",
      "external_name": "stop",
      "side_effects": [
        "EXECUTE"
      ]
    },
    {
      "capability_id": "external.openmaic.load_skill",
      "name": "Load OpenMAIC Skill",
      "description": "Load an OpenMAIC skill pack instruction on demand.",
      "external_name": "load",
      "side_effects": [
        "READ"
      ]
    }
  ]
}
