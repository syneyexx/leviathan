{
  "module_id": "feynman",
  "name": "Feynman Research",
  "version": "0.5.9",
  "entrypoint": "Data.modules.module_manager.external.module:create_external_capability_module",
  "side_effects": [
    "READ",
    "NETWORK"
  ],
  "hot_reload": false,
  "external": {
    "adapter": "COMPOSITE",
    "children": [
      "SKILL_PACK",
      "CLI"
    ],
    "source_type": "git",
    "source": "https://github.com/Companion-Inc/feynman",
    "ref": "main",
    "install": {
      "strategy": [
        "GIT_CHECKOUT",
        "NODE_NPM"
      ],
      "dependencies": [
        "node"
      ],
      "post_install": [
        [
          "npm",
          "run",
          "build"
        ]
      ]
    },
    "skill_roots": [
      "skills"
    ],
    "runtime": {
      "mode": "EPHEMERAL",
      "timeout_seconds": 1800,
      "cwd": "$INSTALL_ROOT",
      "command": [
        "node",
        "bin/feynman.js",
        "help"
      ],
      "operations": [
        {
          "name": "help",
          "command": [
            "node",
            "bin/feynman.js",
            "help"
          ]
        },
        {
          "name": "version",
          "command": [
            "node",
            "bin/feynman.js",
            "--version"
          ],
          "result_format": "text"
        },
        {
          "name": "status",
          "command": [
            "node",
            "bin/feynman.js",
            "status"
          ]
        },
        {
          "name": "doctor",
          "command": [
            "node",
            "bin/feynman.js",
            "doctor"
          ]
        },
        {
          "name": "search_status",
          "command": [
            "node",
            "bin/feynman.js",
            "search",
            "status"
          ]
        },
        {
          "name": "packages_list",
          "command": [
            "node",
            "bin/feynman.js",
            "packages",
            "list"
          ]
        },
        {
          "name": "alpha_status",
          "command": [
            "node",
            "bin/feynman.js",
            "alpha",
            "status"
          ],
          "accept_exit_codes": [
            0,
            1
          ],
          "notes": "Exit 1 when not logged in is an honest status signal, not a fabric failure."
        },
        {
          "name": "research",
          "command": [
            "node",
            "bin/feynman.js",
            "--prompt={topic}"
          ]
        },
        {
          "name": "deepresearch",
          "command": [
            "node",
            "bin/feynman.js",
            "deepresearch",
            "{topic}"
          ]
        },
        {
          "name": "lit",
          "command": [
            "node",
            "bin/feynman.js",
            "lit",
            "{topic}"
          ]
        },
        {
          "name": "run",
          "command": [
            "node",
            "bin/feynman.js",
            "--prompt={topic}"
          ]
        },
        {
          "name": "load",
          "command": [
            "node",
            "-e",
            "console.log(JSON.stringify({ok:true,note:'use external.skills.load'}))"
          ]
        }
      ]
    },
    "result": {
      "format": "MIXED",
      "artifact_globs": [
        "outputs/**",
        "reports/**",
        "*.md",
        "*.pdf"
      ]
    },
    "assimilation_mode": "KNOWLEDGE_CANDIDATE",
    "tags": [
      "research",
      "summarization",
      "papers",
      "skill"
    ],
    "domain": "research",
    "resource_class": "NETWORK_HEAVY",
    "metadata": {
      "does_not_replace_research_service": true,
      "preferred_machine_contract": "Node CLI bin/feynman.js (@companion-ai/feynman) + skills/ SKILL packs",
      "requires_node": ">=22.22.0",
      "setup_note": "Provider auth via `feynman setup` remains BLOCKED_EXTERNAL without credentials"
    }
  },
  "capabilities": [
    {
      "capability_id": "external.feynman.research",
      "name": "Feynman Research",
      "description": "Long-running research synthesis via Feynman Node CLI (external specialist; not ResearchService).",
      "external_name": "research",
      "side_effects": [
        "READ",
        "NETWORK",
        "WRITE"
      ]
    },
    {
      "capability_id": "external.feynman.deepresearch",
      "name": "Feynman Deep Research",
      "description": "Plan-first multi-researcher investigation via Feynman deepresearch.",
      "external_name": "deepresearch",
      "side_effects": [
        "READ",
        "NETWORK",
        "WRITE"
      ]
    },
    {
      "capability_id": "external.feynman.lit",
      "name": "Feynman Literature Review",
      "description": "Literature review via Feynman lit workflow.",
      "external_name": "lit",
      "side_effects": [
        "READ",
        "NETWORK",
        "WRITE"
      ]
    },
    {
      "capability_id": "external.feynman.load_skill",
      "name": "Load Feynman Skill",
      "description": "Load a Feynman skills/ pack instruction on demand.",
      "external_name": "load",
      "side_effects": [
        "READ"
      ]
    },
    {
      "capability_id": "external.feynman.version",
      "name": "Feynman Version",
      "description": "Print Feynman CLI version (no provider auth).",
      "external_name": "version",
      "side_effects": [
        "READ"
      ]
    },
    {
      "capability_id": "external.feynman.status",
      "name": "Feynman Status",
      "description": "Feynman setup status (model/auth/web) without running research.",
      "external_name": "status",
      "side_effects": [
        "READ"
      ]
    },
    {
      "capability_id": "external.feynman.doctor",
      "name": "Feynman Doctor",
      "description": "Feynman doctor diagnostics (honest unauthenticated state).",
      "external_name": "doctor",
      "side_effects": [
        "READ"
      ]
    },
    {
      "capability_id": "external.feynman.search_status",
      "name": "Feynman Search Status",
      "description": "Feynman web-search route/config status (no provider auth required).",
      "external_name": "search_status",
      "side_effects": [
        "READ"
      ]
    },
    {
      "capability_id": "external.feynman.packages_list",
      "name": "Feynman Packages List",
      "description": "List Feynman package presets.",
      "external_name": "packages_list",
      "side_effects": [
        "READ"
      ]
    },
    {
      "capability_id": "external.feynman.alpha_status",
      "name": "Feynman AlphaXiv Status",
      "description": "AlphaXiv login status (honest when not logged in).",
      "external_name": "alpha_status",
      "side_effects": [
        "READ",
        "NETWORK"
      ]
    }
  ]
}
